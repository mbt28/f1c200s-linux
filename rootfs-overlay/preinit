#!/bin/sh
# PID 1 on the NAND boot path (init=/preinit). Assembles the writable root:
#
#   lower  /dev/mtdblock2  squashfs, immutable, never written
#   upper  /dev/mtdblock3  jffs2, every runtime write lands here
#   union  overlayfs       what userspace sees as / -- READ-WRITE
#
# Because nothing ever writes the OS, a power cut at ignition-off can only
# damage the erasable upper layer, never the system.
#
# The SD path never runs this: it boots root=/dev/mmcblk0p2 rw straight into
# /sbin/init with no init= override.
#
# --- TWO TRAPS THIS SCRIPT EXISTS TO AVOID, both verified in source ---
#
# 1. NOT switch_root. busybox switch_root.c:244 does:
#        statfs("/", &stfs);
#        if (f_type != RAMFS_MAGIC && f_type != TMPFS_MAGIC)
#                bb_simple_error_msg_and_die("root filesystem is not ramfs/tmpfs");
#    so it REFUSES on a squashfs root. chroot is the only option here, and is
#    what the vendor firmware does.
#
# 2. NOT `mount --rbind`. busybox mount has no long-option table
#    (util-linux/mount.c calls getopt32 with no applet_long_options), so
#    --rbind dies as an unrecognised option. The flag exists only as `-o rbind`,
#    which CONFIG_FEATURE_MOUNT_FLAGS=y enables. The vendor's own script uses
#    --rbind and would fail on OUR busybox -- do not copy it verbatim.
#
# THIS SCRIPT MUST NEVER EXIT. If PID 1 returns, the kernel panics with
# "Attempted to kill init", which tells you nothing. Every failure path falls
# through to a plain read-only boot instead: degraded, but the serial console
# still gives a root shell (inittab runs -/bin/sh directly), so it is fixable.
#
# Output goes to the console because the kernel opens /dev/console for PID 1
# and devtmpfs is already mounted (CONFIG_DEVTMPFS_MOUNT=y). Progress is
# printed on purpose -- this is the one place where a silent failure would be
# invisible.

mount -n -t proc proc /proc
set -- $(cat /proc/cmdline)
umount /proc

OVL=
for x in "$@"; do
	case "$x" in
	overlayfsdev=*) OVL="${x#overlayfsdev=}" ;;
	# Escape hatches, settable from the U-Boot prompt without reflashing.
	preinit=skip) echo "preinit: skipped -- read-only boot"; exec /sbin/init ;;
	preinit=sh)   echo "preinit: dropping to a shell"; exec /bin/sh ;;
	esac
done

ro_boot() {
	echo "preinit: $1"
	echo "preinit: continuing READ-ONLY -- / will not be writable."
	echo "preinit: recover with: flash_erase /dev/mtd3 0 0   (from an SD boot)"
	exec /sbin/init
}

[ -n "$OVL" ] || ro_boot "no overlayfsdev= on the cmdline"
[ -b "$OVL" ] || ro_boot "$OVL is not a block device"

echo "preinit: mounting $OVL (jffs2) on /overlay"
mount -n -t jffs2 -o rw,noatime "$OVL" /overlay \
	|| ro_boot "jffs2 mount of $OVL failed"

mkdir -p /overlay/rom/lower /overlay/rom/upper /overlay/rom/work \
	|| ro_boot "cannot create the overlay directories"

# rbind rather than a fresh squashfs mount: / is already the squashfs, and
# rbind carries any submounts with it.
mount -n -o rbind / /overlay/rom/lower || ro_boot "rbind of / failed"

mount -n -t overlay overlayfs:/overlay/rom \
	-o rw,noatime,lowerdir=/overlay/rom/lower,upperdir=/overlay/rom/upper,workdir=/overlay/rom/work \
	/mnt \
	|| ro_boot "overlayfs union failed"

# Carry devtmpfs and the jffs2 into the new root. Without /dev the new init
# has no console and dies silently.
mount -n -o rbind /dev     /mnt/dev
mount -n -o rbind /overlay /mnt/overlay

echo "preinit: union ready, handing over to /sbin/init"
exec chroot /mnt /sbin/init

# Only reachable if chroot itself failed.
ro_boot "chroot into the union failed"
