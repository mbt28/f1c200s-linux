#!/bin/sh
# Swap tiers: SD partition p4 (default since 2026-10-03) and, opt-in, zram.
#
# 2026-10-03: the board "freezes" when wireless CarPlay starts video. It is not
# a hang -- with the 24 MiB CMA full of video buffers, 12-14 MiB of anonymous
# memory and 9 MiB of slab leave ~3 MiB of page cache, so every process
# page-faults its own code back from the card (35 000 major faults in three
# minutes, load 12, a shell builtin took 40 s) while the kernel keeps answering
# pings. A swap tier that takes the idle anonymous pages fixes it; zram cannot
# be that tier because zsmalloc's movable pages fragment the CMA pool and the
# decoder then fails to allocate (docs/memory.md s4). So the SD partition is
# the default tier and zram is opt-in (`touch /etc/swap-zram`). Measured with
# SD swap only: 3 MiB swapped, 1 600 major faults in a 15 min video session,
# heartbeat never late.
#
# WHY THIS SCRIPT OWNS BOTH DEVICES. inittab runs `swapon -a` at sysinit, well
# before rcS. zram cannot exist that early (it needs modprobe), so if p4 were
# auto-mounted there it would be enabled FIRST -- and the kernel hands out
# descending priorities in activation order, which would make the SD CARD the
# primary swap. That is the exact failure this design exists to prevent, so p4
# carries `noauto` in fstab and both devices are activated here with EXPLICIT
# priorities. Explicit beats emergent: if zram fails to come up, p4 keeps
# pri=10 and is simply never promoted.
#
# The asymmetry that makes the ordering a safety property, not a preference:
# a SCHED_FIFO video thread faulting on a zram page pays ~100 us of LZO
# decompress. The same fault against the SD card costs 5-50 ms AND contends
# with the rootfs on the same physical card.
#
# Runs at S03: after S01logs (so /var/log exists and the log persists), long
# before S20cedrus/S99carplay, and AFTER busybox's S02sysctl. S02sysctl
# re-applies /etc/sysctl.conf, which is written for zram; as S02swap this script
# sorted before it, so the SD tuning below was undone on every boot until
# 2026-10-23. Nothing here may ever fail the boot.
#
# Escape hatches, none needing a reflash:
#   touch /etc/swap-disable   -> no swap at all
#   zram swap = On in the boot menu's Settings (kernel argument f1c.zram=1),
#   or touch /etc/swap-zram   -> add the zram tier. Without kernel patch 0037
#                                it breaks the video decoder's CMA allocations
#                                on this board (see above).
#   rm /etc/swap-sd           -> no SD tier
#   /etc/default/swap         -> override sizes/algorithm/priorities
#   S03swap stop | start      -> live A/B without rebooting
LOG=/var/log/swap.log
ZRAM_SIZE=16M         # logical swap advertised
ZRAM_MEM_LIMIT=6M     # HARD cap on RAM zsmalloc may hold: patch 0037 keeps it outside CMA, in the ~26 MiB left
ZRAM_ALGO=lzo-rle     # fastest decompress on ARMv5; see linux.fragment
ZRAM_PRI=100
SD_DEV=/dev/mmcblk0p4
SD_PRI=10
SD_SECTORS=131072     # 64 MiB; p4 is declared past EOF, so verify it is real

# A card shared with LEHU OS (lehu-os/docs/dual-boot.md) turns p4 into an
# extended partition (a 2-sector container in sysfs) and moves this swap
# area, unchanged in size, to the first logical partition, p5. Only p5 is
# considered, never any other partition: this script runs mkswap on SD_DEV.
if [ "$(cat /sys/class/block/mmcblk0p4/size 2>/dev/null)" != "$SD_SECTORS" ] &&
   [ "$(cat /sys/class/block/mmcblk0p5/size 2>/dev/null)" = "$SD_SECTORS" ]; then
	SD_DEV=/dev/mmcblk0p5
fi

[ -r /etc/default/swap ] && . /etc/default/swap

log() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >> "$LOG" 2>/dev/null; }

case "$1" in
start)
	# Multi-gen LRU (linux.fragment, "No-swap RAM"). Its thrash guard,
	# min_ttl_ms, stays OFF (0) by default: set to 1000 on 2026-11-06 it made
	# kswapd OOM-kill udevd 8 s into boot with 28 MB free. kswapd woke for a
	# watermark boost and lru_gen_age_node() found no generation it counts as
	# reclaimable -- every lruvec is "too small" at kswapd's priority on this
	# RAM size (mm/vmscan.c says so) -- so it called out_of_memory(). Kept as
	# a knob (LRU_MIN_TTL_MS in /etc/default/swap) for experiments only.
	LRU_MIN_TTL_MS=${LRU_MIN_TTL_MS:-0}
	if echo "$LRU_MIN_TTL_MS" > /sys/kernel/mm/lru_gen/min_ttl_ms 2>/dev/null; then
		log "lru_gen enabled=$(cat /sys/kernel/mm/lru_gen/enabled) min_ttl_ms=$LRU_MIN_TTL_MS"
	else
		log "lru_gen absent (kernel without CONFIG_LRU_GEN)"
	fi

	[ -f /etc/swap-disable ] && { log "disabled by /etc/swap-disable"; exit 0; }

	# Before any swap exists, so the first reclaim uses the new watermarks.
	[ -r /etc/sysctl.conf ] && sysctl -q -p /etc/sysctl.conf 2>/dev/null

	# --- tier 1: zram (opt-in) -------------------------------------------
	# Asked for by the boot menu (f1c.zram=1) or by /etc/swap-zram.
	ZRAM=
	grep -qw "f1c.zram=1" /proc/cmdline 2>/dev/null && ZRAM=boot-menu
	[ -z "$ZRAM" ] && [ -f /etc/swap-zram ] && ZRAM=/etc/swap-zram
	if [ -z "$ZRAM" ]; then
		log "zram skipped (off in the boot menu, no /etc/swap-zram)"
	elif [ ! -e /sys/block/zram0 ]; then
		modprobe zram num_devices=1 2>/dev/null
		# devtmpfs-only image: give the node a moment to appear.
		i=0
		while [ ! -e /sys/block/zram0 ] && [ $i -lt 20 ]; do
			i=$((i + 1))
			usleep 100000 2>/dev/null || sleep 1
		done
	fi

	if [ -n "$ZRAM" ] && [ -e /sys/block/zram0 ]; then
		# ORDER IS LOAD-BEARING (Documentation/.../zram.rst): comp_algorithm
		# must precede disksize (it returns -EBUSY once initialised);
		# mem_limit is runtime-adjustable and follows.
		echo "$ZRAM_ALGO"      > /sys/block/zram0/comp_algorithm 2>/dev/null
		echo "$ZRAM_SIZE"      > /sys/block/zram0/disksize       2>/dev/null
		echo "$ZRAM_MEM_LIMIT" > /sys/block/zram0/mem_limit      2>/dev/null
		if mkswap /dev/zram0 >/dev/null 2>&1 &&
		   swapon -p "$ZRAM_PRI" /dev/zram0 2>/dev/null; then
			log "zram0 up ($ZRAM): $ZRAM_SIZE disk, $ZRAM_MEM_LIMIT cap, $(cat /sys/block/zram0/comp_algorithm 2>/dev/null)"
		else
			log "zram0 FAILED to activate"
		fi
	elif [ -n "$ZRAM" ]; then
		log "zram0 absent (CONFIG_ZRAM=m not loaded?)"
	fi

	# --- tier 2: SD card -------------------------------------------------
	# Until 2026-10-03 this tier refused to come up without zram ("never make
	# the card primary swap"). Measured, the opposite holds: without any swap
	# the card is hammered anyway -- by re-reading executable pages -- and a
	# few MiB of cold anonymous memory parked on p4 is what stops that.
	if [ ! -f /etc/swap-sd ]; then
		log "SD swap skipped (no /etc/swap-sd)"
	elif [ "$(cat /sys/class/block/${SD_DEV#/dev/}/size 2>/dev/null)" != "$SD_SECTORS" ]; then
		log "SD swap skipped: $SD_DEV is not $SD_SECTORS sectors (card too small?)"
	else
		# busybox blkid cannot see a swap signature
		# (CONFIG_FEATURE_VOLUMEID_LINUXSWAP is off), so do not probe --
		# try, and format only on failure. Self-healing: a swap area torn by
		# an abrupt power cut is simply re-made on the next boot.
		if swapon -p "$SD_PRI" "$SD_DEV" 2>/dev/null; then
			log "SD swap attached (pre-existing signature)"
		elif mkswap "$SD_DEV" >/dev/null 2>&1 &&
		     swapon -p "$SD_PRI" "$SD_DEV" 2>/dev/null; then
			log "SD swap attached (mkswap'd)"
		else
			log "SD swap FAILED (harmless; zram carries on)"
		fi
	fi

	# SD-only tuning (sysctl.conf is written for the zram case): let anon go
	# out rather than file pages (the thrash IS file pages), and read 8 pages
	# per swap-in -- on the card the cost is the command, not the bytes.
	if grep -q "^$SD_DEV " /proc/swaps && ! grep -q '^/dev/zram0 ' /proc/swaps; then
		sysctl -q -w vm.swappiness=60 vm.page-cluster=3 2>/dev/null
	fi

	# One quiet line to the console -- this board's RT thread has already been
	# throttled once by console flooding. Detail goes to the log.
	echo "swap: $(awk 'NR>1 {printf "%s(pri %s) ", $1, $5}' /proc/swaps)"
	log "swappiness=$(cat /proc/sys/vm/swappiness) page-cluster=$(cat /proc/sys/vm/page-cluster)"
	;;
stop)
	# Snapshot before tearing down: a non-zero Used on p4, or a rising write
	# count, means the conservative policy is not holding and wants
	# investigating. This is the evidence trail for SD wear.
	log "--- shutdown ---"
	awk 'NR>1 {print "  swap " $1 " used=" $4 "kB pri=" $5}' /proc/swaps >> "$LOG" 2>/dev/null
	[ -r /sys/block/zram0/mm_stat ] && log "  zram mm_stat: $(cat /sys/block/zram0/mm_stat)"
	[ -r /sys/class/block/${SD_DEV#/dev/}/stat ] && log "  ${SD_DEV#/dev/mmcblk0} blkstat: $(cat /sys/class/block/${SD_DEV#/dev/}/stat)"
	# swapoff on a full zram must decompress everything back into RAM; if it
	# cannot it fails ENOMEM and leaves swap on, which is safe.
	swapoff "$SD_DEV"    2>/dev/null
	swapoff /dev/zram0   2>/dev/null
	echo 1 > /sys/block/zram0/reset 2>/dev/null
	rmmod zram 2>/dev/null
	;;
*)
	echo "usage: $0 {start|stop}"
	;;
esac
