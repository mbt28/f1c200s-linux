#!/bin/sh
# Boot splash: psplash with LEHU's badge (board/lctech/pi-f1c200s/splash/),
# a progress bar and the last init scripts under it, which rcS feeds it
# through /run/psplash_fifo; rcS also tells it to quit after the last
# script. LEHU OS shows the same splash.
# The sun4i DRM pipeline defer-probes, so wait briefly for fb0.

case "$1" in
start)
	command -v psplash >/dev/null 2>&1 || exit 0
	n=0
	while [ ! -e /dev/fb0 ] && [ "$n" -lt 50 ]; do
		usleep 100000 2>/dev/null || sleep 1
		n=$((n + 1))
	done
	[ -e /dev/fb0 ] || exit 0
	psplash </dev/null >/dev/null 2>&1 &
	# Wait for its pipe, so that rcS's first message is not lost.
	n=0
	while [ ! -p /run/psplash_fifo ] && [ "$n" -lt 40 ]; do
		usleep 50000 2>/dev/null || sleep 1
		n=$((n + 1))
	done
	;;
stop)
	;;
*)
	echo "Usage: $0 {start|stop}"
	;;
esac
