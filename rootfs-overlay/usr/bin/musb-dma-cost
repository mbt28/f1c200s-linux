#!/bin/sh
# musb-dma-cost -- Stage 0 of docs/musb-dma-fix-plan.md: does MUSB DDMA pay for
# itself on this SoC, or is PIO fast enough that the DMA backend should just be
# deleted?
#
# This measures COST, not correctness. It cannot detect the silent bulk-OUT
# loss -- a store that vanished into a DMA-owned FIFO looks identical to one
# that reached the device, in the tracepoints and in the byte counts alike.
# Correctness needs the md5 oracles in the plan's section 6. Do not cite this
# script as evidence that DMA is safe.
#
# The comparison is a reboot apart, because use_dma is boot-time only (a
# runtime toggle leaves the controller in a dirty DMA<->PIO state -- see
# docs/musb-datapath-serialization-roadmap.md section 6):
#
#   1. boot with musb_hdrc.use_dma=0   (what uboot-sdcard.fragment ships), run this
#   2. boot with musb_hdrc.use_dma=1                                     , run this
#   3. compare the two RESULT lines
#
# Fixed BYTES rather than fixed seconds, so both modes move exactly the same
# traffic and the numbers divide cleanly into cost-per-MB. Reading a block
# device fills the buffer cache, so caches are dropped first -- on 64 MiB of
# RAM a cached second run would otherwise look free.
#
# GO/NO-GO: if PIO leaves adequate headroom for the video stream, the plan says
# stop -- delete sunxi_dma.c, drop patches 0016/0017/0019, close the workstream.
# PIO did ~21 Mbps on the storage test and the stream needs a few, so a null
# result here is the expected outcome and a good one.
#
# Usage:
#   musb-dma-cost                  # storage load only, 32 MiB
#   musb-dma-cost -v               # also run wired CarPlay, so the video
#                                  #   stream and the mux compete for the FIFO
#                                  #   (this is the load that matters)
#   musb-dma-cost -m 64            # move 64 MiB instead
#   musb-dma-cost -d /dev/sdb      # different stick
#
# No perf: ARM926EJ-S is ARMv5 and has no PMU, so Linux has no perf backend
# here and `perf stat` reports <not supported> for every counter.

MIB=32
DEV=
VIDEO=0
SET=/tmp/musb-cost-cpw.txt
LOG=/tmp/musb-cost-app.log

while [ $# -gt 0 ]; do
	case "$1" in
	-m) MIB=$2; shift 2 ;;
	-d) DEV=$2; shift 2 ;;
	-v) VIDEO=1; shift ;;
	*) echo "usage: musb-dma-cost [-m MiB] [-d /dev/sdX] [-v]" >&2; exit 2 ;;
	esac
done

# --- the stick -------------------------------------------------------------
# Enumeration is VBUS-flaky at boot on this board; reseating it is the fix.
if [ -z "$DEV" ]; then
	for d in /dev/sda /dev/sdb /dev/sdc; do
		[ -b "$d" ] && { DEV=$d; break; }
	done
fi
[ -b "$DEV" ] || {
	echo "musb-dma-cost: no USB block device (reseat the stick; it is VBUS-flaky at boot)" >&2
	exit 1
}

MODE=$(cat /sys/module/musb_hdrc/parameters/use_dma 2>/dev/null || echo '?')
case "$MODE" in
Y|1) MODE=dma ;;
N|0) MODE=pio ;;
*)   MODE="unknown($MODE)" ;;
esac

# --- counter snapshots -----------------------------------------------------
# /proc/stat cpu line: user nice system idle iowait irq softirq steal...
# System cost is what we are buying with DMA, so track system+irq+softirq.
cpu_busy() {
	awk '/^cpu /{print $4+$7+$8}' /proc/stat
}

# Interrupt totals for the two controllers on the path. Match the names as
# /proc/interrupts actually spells them: the DMA controller is named by DT node
# address (1c02000.dma-controller) but MUSB is not -- it registers as
# "musb-hdrc.1.auto". Matching 1c13000 silently reports 0 for every run.
irq_count() {
	awk -v pat="$1" '$0 ~ pat {s=0; for (i=2; i<=NF; i++) if ($i ~ /^[0-9]+$/) s+=$i; print s; exit}' \
		/proc/interrupts
}

# utime+stime of the app's realtime thread, in ticks. /proc/PID/stat's comm
# field can contain spaces and parens, so index from after the LAST ')':
# remainder field 12 = utime, 13 = stime, 38 = rt_priority.
rt_thread_ticks() {
	pid=$(pidof fastcarplay 2>/dev/null | cut -d' ' -f1)
	[ -n "$pid" ] || { echo 0; return; }
	for t in /proc/$pid/task/*/stat; do
		[ -r "$t" ] || continue
		set -- $(sed 's/.*) //' "$t")
		[ $# -ge 38 ] || continue
		# ${38} is rt_priority; only the RT thread is interesting here.
		case "${38}" in 0|"") continue ;; esac
		echo $(( ${12} + ${13} ))
		return
	done
	echo 0
}

# --- optional video load ---------------------------------------------------
# The storage read alone does not reproduce the case the plan cares about --
# an RX stream and CPU FIFO traffic on the shared datapath at the same time.
if [ "$VIDEO" = 1 ]; then
	[ -r /etc/fastcarplay/settings_drm.txt ] || {
		echo "musb-dma-cost: no settings_drm.txt; cannot start the app" >&2
		exit 1
	}
	sed 's|^protocol.*|protocol = carplay-wired|' \
		/etc/fastcarplay/settings_drm.txt > $SET
	killall fastcarplay 2>/dev/null
	sleep 4
	# Detached from the tty on purpose: the app grabs the console otherwise
	# and the serial session goes deaf until Ctrl-C.
	setsid sh -c "exec fastcarplay $SET > $LOG 2>&1" < /dev/null > /dev/null 2>&1 &
	echo "waiting 40 s for the session to come up..."
	sleep 40
fi

sync
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null

# --- the measured window ---------------------------------------------------
c0=$(cpu_busy)
m0=$(irq_count musb-hdrc)
d0=$(irq_count 1c02000)
r0=$(rt_thread_ticks)
t0f=$(cut -d' ' -f1 /proc/uptime)

dd if="$DEV" of=/dev/null bs=64k count=$(( MIB * 16 )) 2>/tmp/musb-cost-dd.log

t1f=$(cut -d' ' -f1 /proc/uptime)
r1=$(rt_thread_ticks)
d1=$(irq_count 1c02000)
m1=$(irq_count musb-hdrc)
c1=$(cpu_busy)

# --- report ----------------------------------------------------------------
# USER_HZ is 100 on this kernel, so ticks are centiseconds.
elapsed=$(awk -v a="$t0f" -v b="$t1f" 'BEGIN{printf "%.2f", b-a}')
cpu=$(( c1 - c0 ))
musbirq=$(( m1 - m0 ))
dmairq=$(( d1 - d0 ))
rt=$(( r1 - r0 ))

echo
echo "=== musb-dma-cost: $MIB MiB from $DEV, mode=$MODE, video=$VIDEO ==="
grep -E 'copied|bytes' /tmp/musb-cost-dd.log 2>/dev/null | tail -1
awk -v e="$elapsed" -v m="$MIB" -v c="$cpu" -v mi="$musbirq" -v di="$dmairq" -v rt="$rt" \
    -v mode="$MODE" -v v="$VIDEO" 'BEGIN {
	printf "RESULT mode=%s video=%s  %.2f s  %.2f MiB/s  %.1f Mbps\n", mode, v, e, m/e, m*8.388608/e
	printf "  cpu system+irq+softirq : %d cs  (%.1f%% of window, %.2f cs/MiB)\n", c, (e>0?c/e:0), c/m
	printf "  musb irqs (musb-hdrc)  : %d  (%.0f/MiB)\n", mi, mi/m
	printf "  ddma irqs (1c02000)    : %d  (%.0f/MiB)\n", di, di/m
	printf "  app RT thread utime+st : %d cs%s\n", rt, (rt==0 ? "  (no RT thread found -- app not running?)" : "")
}'

if [ "$VIDEO" = 1 ]; then
	echo "--- app ---"
	grep -aE 'carkit|iAP2|MFi|duplicate|CarPlayStart' $LOG | tail -5
fi

echo
echo "Compare this RESULT block against the other boot mode. DMA only pays if"
echo "it buys back meaningful cpu cs/MiB at equal or better MiB/s."
