# Kernel config tweaks for the Lctech Pi F1C200s (suniv / ARMv5, 64 MiB).
# Layered on top of the in-tree "sunxi" defconfig.

# suniv is ARMv5 (ARM926). The sunxi defconfig is multi-platform; turning off
# MULTI_V7 selects the ARMv5 (suniv) build path.
# CONFIG_ARCH_MULTI_V7 is not set

# Networking core is required: libusb's hotplug backend uses a netlink uevent
# socket (NETLINK_KOBJECT_UEVENT) to init, and FastCarPlay's libusb_init() fails
# with LIBUSB_ERROR_OTHER without it. (IPv4 is not added here -- it already
# arrives from the base sunxi defconfig, CONFIG_INET=y.)
CONFIG_NET=y
CONFIG_UEVENT_HELPER=y

# IPv6 is REQUIRED by FastCarPlay's CarPlay backends. The base sunxi defconfig
# explicitly turns it off ("# CONFIG_IPV6 is not set"), which is why the board
# had no /proc/net/if_inet6 and the app's :7000 control server died on its
# AF_INET6 socket with EAFNOSUPPORT (observed on-target, 6.6.143).
# BOTH CarPlay paths hand the phone an IPv6 link-local address to connect back
# to -- wired sends CarPlayStartSession { ip = fe80::..%usb0, port = 7000 } and
# wireless does the same over wlan0. There is no IPv4 form of that handshake,
# so it cannot be worked around in the app. Android Auto (IPv4 over AOAP) is
# unaffected. Kconfig gate: IPV6 sits inside "if INET" in net/Kconfig, so the
# base defconfig's INET=y is what makes this stick. It costs kernel text on
# this 64 MiB part (cf. the RAM diet below) -- unavoidable, CarPlay cannot
# start without it.
CONFIG_IPV6=y

# 480x272 RGB LCD via the sun4i DRM driver (binds the suniv DE/TCON through
# their sun4i-a10 fallback compatibles; panel qd43003c0-40 is in panel-simple).
# Display nodes are added by patches/linux-lctech/0001-...-lcd-and-gt911-touch.patch
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN4I_BACKEND=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
# Framebuffer present, but NO text console on the LCD: this is a CarPlay
# appliance, the panel is owned by the video (FastCarPlay -> /dev/fb0) and the
# console lives on the serial port. Disabling FRAMEBUFFER_CONSOLE keeps /dev/fb0
# (from DRM fbdev emulation) while stopping the text console/cursor from
# fighting the video. (cf. removing console=tty0 from the bootargs.)
CONFIG_FB=y
# No virtual terminals at all: the console is serial-only and the LCD belongs
# to the splash/video (fb0 comes from DRM fbdev emulation, which needs no VT).
# VT's prompt is `bool "Virtual terminal" if EXPERT` with `default y` — without
# EXPERT=y the not-set line is silently ignored and olddefconfig forces VT back
# on. EXPERT only unhides prompts (config-diff audited: no built code changes),
# but it selects DEBUG_KERNEL as a menu gate, so keep DEBUG_MISC off to make
# that gate inert. FRAMEBUFFER_CONSOLE must be explicitly off too: the base
# defconfig sets it (and it would paint a text cursor on the LCD).
CONFIG_EXPERT=y
# CONFIG_DEBUG_MISC is not set
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# Backlight enable on GPIO PE6 (gpio-backlight). Without this the panel is
# driven but stays dark.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y

# Goodix GT911 capacitive touch on I2C0 (TWI0).
CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y
# MFi authentication coprocessor -- FastCarPlay drives it from userspace via the
# i2c-dev chardev (mfi-i2c-bus = /dev/i2c-0). It shares i2c0, the only bus this
# board enables: MFi answers at 0x10/0x11, the GT911 at 0x5d, so no clash.
# The base sunxi defconfig happens to set this; declared here so a defconfig
# bump cannot silently drop it and take CarPlay authentication with it.
CONFIG_I2C_CHARDEV=y

# Mainline cedrus (V4L2 stateless H.264) video decoder -- the only decoder on
# this image; blob-free. It binds the DT "video-engine" node and claims SRAM-C
# via sunxi_sram; decode buffers come from CMA (vb2-dma-contig).
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_SUNXI=y
CONFIG_SUNXI_SRAM=y
# CMA is the pool cedrus' vb2-dma-contig allocates decode buffers from.
# HARD LIMIT: on this 64 MiB part the early CMA reservation in setup_arch wedges
# *before the console comes up* if too large -- 32 MiB hangs at "Starting kernel"
# with no output. 16 MiB is the proven-bootable value. Paired with the ffmpeg
# patch that right-sizes the coded buffer to ~1 MiB, 16 MiB holds the cedrus
# H.264 pool for <=480p (~7-13 MiB). 720p (~20 MiB) needs more CMA than reliably
# boots here -> use a dedicated VE carveout instead (see docs/ffmpeg-v4l2-request.md).
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
# cedrus as a MODULE, loaded post-boot (autorun) -- the validated path. Built-in
# (=y) lets the VE probe (clk_set_rate PLL_VE / VE reset / SRAM claim) run during
# boot and wedge it before login; =m keeps the probe off the boot path so a probe
# hiccup can never brick the board. modalias coldplug does not auto-load it here.
CONFIG_VIDEO_SUNXI_CEDRUS=m
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_GENERIC_ALLOCATOR=y

# USB host -- needed for the CarPlay / Android Auto dongle (talked to via
# libusb from FastCarPlay). The musb + usb-phy suniv drivers are mainline
# since ~6.3.
# NOTE: the in-tree lctech DT sets the OTG port to dr_mode = "peripheral".
# A dr_mode = "host" (or "otg") DT override is still required before the
# dongle will enumerate -- added with the FastCarPlay layer.
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_PHY=y
CONFIG_PHY_SUN4I_USB=y
# MUSB DMA via the SoC dedicated-DMA engine (patches 0016/0017) -- DISABLED,
# PARKED 2026-08-08. It does not work on this silicon, and where it does run it
# is slower than the PIO it replaces. Measured on hardware, kernel 6.18.42
# (full write-up: docs/musb-dma-fix-plan.md):
#
#   storage 64 MiB  PIO 10.05 MiB/s, 10.03 cs/MiB | DDMA 3.28 MiB/s, 29.17 cs/MiB
#   wired CarPlay   PIO full session, 28-30 fps   | DDMA never establishes at all
#
# Two independent reasons, either one sufficient on its own:
#
# 1. CORRECTNESS. The FIFO RAM is single-port and muxed CPU-vs-DMA by a GLOBAL
#    VEND0 BUS_SEL bit (reg 0x43) with NO hardware arbiter -- Allwinner's own BSP
#    says arbitration only arrived in "1667 1673 and later ic". A CPU FIFO write
#    issued while a DMA owns the datapath is silently lost: the controller still
#    sets TXPKTRDY, the URB completes reporting the full byte count, and the
#    phone reports a usbmux sequence gap. usbmux has no retransmission, so one
#    drop kills the session -- "carkit open failed", reproduced 11x under DDMA
#    and gone the moment the same board reboots into PIO.
#
# 2. PERFORMANCE. musb_host.c pins RX DMA to mode 0 (USE_MODE1 is #ifdef'd out
#    upstream), so the engine is armed and torn down once per 512-byte packet
#    and the per-packet MUSB interrupt is NOT suppressed: 2074 musb irq/MiB in
#    PIO vs 2079 in DMA, with 2062 DDMA irq/MiB added on top. DMA eliminates
#    nothing and pays a second interrupt plus two kzallocs per packet to replace
#    a FIFO copy worth ~128 load/store pairs. Mode 1 would fix the economics but
#    is precisely what the missing arbiter forbids -- it would hold BUS_SEL for
#    ~1 ms while the device paces the stream.
#
# Patches 0016/0017 are deliberately KEPT, not dropped, so this can be revisited
# if better documentation for the suniv MUSB DMA path ever surfaces. They are
# guarded by #ifdef CONFIG_USB_SUNXI_DMA and fall back to mainline's NULL stubs,
# so the tree builds clean with this off. To revive: flip both symbols to =y.
# musb_hdrc.use_dma=0 in uboot-sdcard.fragment stays as belt-and-braces.
# CONFIG_USB_SUNXI_DMA is not set
# USB_UX500_DMA only ever existed here to make sunxi_dma's MUSB_DMA_UX500 quirk
# bit live (patch 0016 widened its Kconfig depends to allow it on sunxi). With
# the backend off nothing sets that bit, so it goes off with it.
# CONFIG_USB_UX500_DMA is not set

# USB Ethernet: Realtek RTL8153 (Lenovo 17ef:720c USB-C to LAN + kin).
# Primary use: stress-test the MUSB host DMA path locally -- iperf --bidir over
# this NIC hammers bulk RX-DMA + TX across the shared BUS_SEL datapath (the
# kernel's own documented tx-fifo-flush repro), no phone required. Also serves
# the SSH/SCP dev loop. Built-in so the NIC binds on plug, no module dance.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
# Wired CarPlay's DATA path -- REQUIRED, and it takes both drivers together.
# In USB config 6 the iPhone exposes a CDC-NCM function:
#   ipheth  binds the Apple vendor interface (ff/fd) and sends the vendor
#           control request that switches the phone into NCM mode;
#   cdc_ncm then binds the CDC-NCM data interface and creates usb0, whose
#           fe80:: link-local is exactly what the app hands the phone in
#           CarPlayStartSession so it can connect back to [fe80::..%usb0]:7000.
# Without usb0 the app loops on "usb0 has no IPv6 link-local -- NCM link down"
# and there is no CarPlay AV path at all (observed on-target, 6.6.143).
# Built-in for the same reason as the RTL8152 above -- they bind on plug, no
# module dance. Dependency chain checked against 6.6 drivers/net/usb/Kconfig:
# USB_NET_CDC_NCM depends on USB_USBNET and SELECTS USB_NET_CDCETHER (spelled
# out here because it used to be disabled in this file); USB_USBNET selects
# MII. USB_IPHETH is standalone -- it does NOT use the usbnet framework and
# needs only the USB_NET_DRIVERS menu gate above.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_IPHETH=y
# All other USB-NIC drivers stay dropped (explicitly, so the base sunxi
# defconfig can't pull them back in) to keep the image minimal.
# CONFIG_USB_NET_DM9601 is not set
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_AX88179_178A is not set
# CONFIG_USB_NET_SMSC95XX is not set

# USB-gadget ethernet (g_ether) for the dev loop: Type-C straight to the dev host
# = power + a deterministic usb0 link, no adapter/firmware/hub. Active only when
# the OTG is in peripheral mode (the dev image's DTS; the CarPlay image keeps host
# mode via patch 0004, where this gadget is simply unused). USB_GADGET is already y.
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y

# USB mass storage — for the phone-free MUSB RX-DMA collision reproducer:
# `dd if=/dev/sda bs=64k` (large 4-aligned bulk-IN) drives the RX-DMA path
# (IRQ 17 climbs), hammered by concurrent ep0 control transfers (TX-PIO) →
# corruption we can md5-detect. SCSI core is already =y; add usb-storage + the
# SCSI disk (sd_mod). See docs/musb-datapath-serialization-roadmap.md.
CONFIG_USB_STORAGE=y
CONFIG_BLK_DEV_SD=y

# --- ESP-Hosted-NG wireless: ESP32 co-processor on SPI1 (docs/wireless-esp-hosted.md) ---
# spi1 controller (sun8i-h3-compatible, pins PE7-PE10 via patch 0012) carries
# the ESP32 link. The WiFi/BT stacks stay modular: `wifi on` modprobes the
# out-of-tree esp32_spi module, which pulls cfg80211 + bluetooth in via
# symbol dependencies -- zero resident cost while wifi is off.
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y

# --- On-board SPI NAND on spi0 (the chip the stock firmware boots from) ---
# Measured on the board's own vendor firmware:
#   spi-nand spi0.0: GigaDevice SPI NAND was found.
#   128 MiB, block size: 128 KiB, page size: 2048, OOB size: 64
# Stock lays it out as u-boot(512K) / kernel.itb(5.5M) / rom(64M, squashfs) /
# overlay(48M, jffs2) via DT fixed-partitions.
#
# Our board .dts already declares the chip (compatible = "spi-nand" under
# &spi0) but defines NO partitions node, so this kernel will present the WHOLE
# 128 MiB as a single /dev/mtd0. That is deliberate for now and is exactly what
# a full backup wants -- one nanddump of the entire chip, bad-block info and
# OOB included. Partitions come later, when we actually install to it.
#
# MTD_SPI_NAND pulls in MTD_NAND_CORE, MTD_NAND_ECC and SPI_MEM by select, so
# none of those need listing. MTD_OF_PARTS is `default y` and would arrive on
# its own; it is spelled out because it is what will parse the partition map
# once the .dts grows one, and a silent default is how the CONFIG_VT trap bit
# us twice.
#
# Probing is read-only (chip ID + parameter page), so enabling this cannot
# disturb the vendor firmware sitting on the chip.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_OF_PARTS=y

# System DMA (A10-class NDMA/DDMA, backported by patch 0014): spi-sun6i picks
# the channels up from the DT and stops burning ~25 FIFO IRQs per ESP frame.
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN4I=y
# WIRELESS is the menu gate CFG80211 lives behind -- without it =m is
# silently dropped (same kconfig trap as VT/EXPERT). WLAN (the in-tree
# vendor-driver menu) stays off: our driver is out-of-tree.
CONFIG_WIRELESS=y
# RFKILL: REQUIRED by FastCarPlay's aa-wireless backend (it drives
# /dev/rfkill to manage the radios); also silences the rfkill probe warning
# wpa_supplicant/hostapd print at startup. Do not remove in future diets.
CONFIG_RFKILL=y
CONFIG_CFG80211=m
# REQUIRE_SIGNED_REGDB defaults y and selects BUILT-IN X.509/PKCS7/ASN.1
# (~150 KiB resident even with wifi off). Its prompt hides behind
# CERTIFICATION_ONUS (visible thanks to EXPERT); with it off, cfg80211
# loads the plain regulatory.db that wireless-regdb ships.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_BT=m
# BT rides a dedicated UART (H4 on ttyS1/PE0-PE1 to the ESP32's spi+uart
# firmware; patch 0013) after HCI-over-SPI proved flaky. `bt on` runs
# hciattach; hci_uart stays modular like the rest of the wireless stack.
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
# RFCOMM: bluetoothd needs kernel RFCOMM to bind the profile listener and
# publish the SDP channel for FastCarPlay's wireless-Android-Auto profile
# (UUID 4de17a00-...) and HFP. Without it, RegisterProfile logs success but
# the adapter advertises nothing, so the phone bonds then finds no AA service
# over SDP and drops the link ("couldn't pair" -- btmon-confirmed on-target
# 2026-07-10). =m, NOT =y: the BT core is modular (CONFIG_BT=m), so a built-in
# RFCOMM cannot link against bluetooth.ko. kconfig does NOT catch this (the
# intermediary BT_BREDR is a bool that launders BT's tristate), so =y survives
# olddefconfig and then breaks the kernel link. As a module, rfcomm.ko lands
# in modules.dep and autoloads when bluetoothd opens the RFCOMM socket.
CONFIG_BT_RFCOMM=m

# --- RAM diet (docs/memory.md, measured 2026-07-05) ---
# The multi-platform sunxi base config carries ~13 MiB of resident kernel;
# these cuts return ~3.5-4 MiB to userspace on the 64 MiB board.
# Biggest single lever: optimize for size instead of performance (~15-20% text).
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# NFS client (+ sunrpc): ~0.8 MiB, never used on the appliance.
# CONFIG_NFS_FS is not set
# Sound: minimal ALSA for the F1C200s internal codec (CarPlay audio output is
# planned; FastCarPlay's PcmAudio plays through SDL/ALSA once the dummy audio
# driver is dropped). The unused transports stay off: USB-audio class, I2S,
# SPDIF and the dummy/loopback SND_DRIVERS gate - that keeps ~half of the
# original 302 KiB sound-stack saving.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y
# CONFIG_SND_USB is not set
# CONFIG_SND_SUN4I_I2S is not set
# CONFIG_SND_SUN4I_SPDIF is not set
# CONFIG_SND_DRIVERS is not set
# perf events / suspend / HID: unused on a fixed-function appliance.
# CONFIG_PERF_EVENTS is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM_SLEEP is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_HID is not set
# CONFIG_USB_HID is not set

# === Debug instrumentation: RETIRED 2026-08-08 ===
# This block was TEMPORARY for two investigations, both now closed: the CMA
# leak (fixed 2026-07-19, patch 0020) and the MUSB DDMA bring-up (parked,
# 4da8c3f). It was costing real resident RAM on a 52 MiB board.
#
# DMA_API_DEBUG is the expensive one and the reason this got revisited.
# kernel/dma/debug.c preallocates PREALLOC_DMA_DEBUG_ENTRIES = 1<<16 = 65536
# struct dma_debug_entry at core_initcall and NEVER frees them. On this target
# (32-bit, UP so ____cacheline_aligned_in_smp is a no-op, no STACKTRACE) the
# struct is ~56-64 B, so that is ~3.5-4 MiB gone before userspace starts, plus
# a static dma_entry_hash[16384] in BSS (~190 KiB). More than the whole zram
# exercise nets, at zero runtime cost.
# CONFIG_DMA_API_DEBUG is not set
#
# FTRACE must be turned off EXPLICITLY, not merely deleted. CONFIG_EXPERT=y
# above (needed to unhide the CONFIG_VT prompt) `select`s DEBUG_KERNEL
# (init/Kconfig:1637), and FTRACE is `default y if DEBUG_KERNEL`
# (kernel/trace/Kconfig:197) -- so dropping the line lets olddefconfig put it
# straight back. Exactly the CONFIG_VT trap documented in docs/memory.md that
# already cost two rebuilds. ENABLE_DEFAULT_TRACERS and TRACING live inside
# `if FTRACE` and go with it. This also removes the landmine that a single
# `echo 1 > tracing_on` allocates a ~1.4 MiB ring buffer and never returns it.
# CONFIG_FTRACE is not set
#
# dynamic_debug retains every format string plus a __dyndbg descriptor table.
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_CMA_DEBUGFS is not set
#
# KEPT deliberately:
#  - DEBUG_FS: needed by the overlay diagnostic tools and by zram's counters.
#  - IKCONFIG: CLAUDE.md verifies the shipped config via /proc/config.gz.
# DEBUG_KERNEL is not listed: EXPERT selects it regardless, so a line here
# would be decorative. Reviving the MUSB work means reverting this hunk --
# rootfs-overlay/usr/bin/musb-mux-trace degrades cleanly (it already checks for
# the tracepoints and exits with a message).
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# zram: compressed swap in RAM, driven by rootfs-overlay/etc/init.d/S02swap.
# ONE line is genuinely all that is needed. ZRAM is a tristate that selects
# ZSMALLOC, and ZRAM_BACKEND_FORCE_LZO is a def_bool that fires when no other
# backend is chosen, giving lzo-rle as ZRAM_DEF_COMP. Do NOT add CONFIG_CRYPTO_*
# -- zram in 6.18 no longer uses the crypto API and those would be dead weight.
#
# =m, not =y: keeps it off the boot path, lets a video A/B unload it live
# (swapoff /dev/zram0; rmmod zram), and reverting is this one line.
#
# lzo-rle (the default) is the right algorithm here and needs no symbol: it has
# the fastest decompress on ARMv5, which matters because every page-in is a
# synchronous decompress executed BY THE FAULTING THREAD on the only core --
# and one of those threads is the SCHED_FIFO video reader. zstd's better ratio
# is not worth 5-10x the compress time in that position.
CONFIG_ZRAM=m
