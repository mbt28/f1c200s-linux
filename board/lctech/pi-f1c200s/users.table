# The everyday user. Its password is locked like root's ("*"): the serial console
# logs it in without one (inittab, see post-build.sh), SSH takes the keys in
# rootfs-overlay/home/f1c/.ssh/authorized_keys, and root is one passwordless
# `sudo` away (rootfs-overlay/etc/sudoers.d/f1c). i2c is created here for the MFi
# coprocessor and the GT911 (see rootfs-overlay/etc/udev/rules.d).
f1c -2 f1c -2 * /home/f1c /bin/sh video,input,audio,dialout,plugdev,netdev,i2c F1C200s user
