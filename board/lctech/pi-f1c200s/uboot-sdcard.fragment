# Boot the kernel from the SD card.
#
# The lctech_pi_f1c200s board + DT alias serial0 -> uart1 (the on-board CH340
# USB-C serial on PA2/PA3), so the Linux console is ttyS0 here even though it
# is physically UART1.  The U-Boot defconfig already sets CONS_INDEX=2.
#
# Partition layout (see genimage-sdcard.cfg): p1 = FAT (zImage + dtb),
# p2 = ext4 rootfs, p3 = ext4 logs (mounted /var/log, kept off the rootfs so a
# torn log costs a fsck of p3 and not the boot).  DRAM base 0x80000000.
# musb_hdrc.use_dma=0 forces the USB host onto PIO. REQUIRED for wired CarPlay:
# with MUSB DMA enabled the controller completes bulk-OUT transfers the device
# never receives (the iPhone reports usbmux sequence gaps, and usbmux has no
# retransmission, so one silent drop kills the session). The suniv FIFO RAM is
# muxed CPU-vs-DMA by a GLOBAL VEND0 BUS_SEL bit and this IC has no hardware
# arbitration -- Allwinner's own USBC_SelectBus() says that only arrived in
# "1667 1673 and later ic". See docs/musb-mux-starvation.md and
# docs/musb-suniv-hardware-facts.md.
#
# This is the conservative fix: it also disables the DDMA offload that patches
# 0016-0019 added for wired Android Auto. Drop this once the datapath is
# properly serialised and the offload can be re-enabled safely.
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="console=ttyS0,115200 panic=5 rootwait root=/dev/mmcblk0p2 rw rootfstype=ext4 musb_hdrc.use_dma=0"

# --- On-board SPI NAND (spi0): drive it, and boot from it if there is no SD ---
#
# CMD_MTD is a plain bool with NO default, so without it the `mtd` command does
# not exist at all. MTD_SPI_NAND selects MTD_NAND_CORE and SPI_MEM; DM_SPI is
# already on. Verified on hardware: a build with exactly these three was
# FEL-booted and `mtd list` correctly reported the GigaDevice 128 MiB chip
# (128 KiB blocks, 2048 B pages, ECC strength 8).
#
# Cost measured at +35.5 KiB, giving 457.8 KiB against mtd0's 512 KiB. That is
# comfortable but not roomy -- re-measure u-boot-sunxi-with-spl.bin whenever
# this config grows.
#
# CAUTION: U-Boot's `mtd bad` reports 514 FALSE bad blocks on this chip (three
# perfectly contiguous runs totalling 64 MiB) where Linux reports zero. Its
# bad-block marker interpretation disagrees with vendor-written data. Never
# drive a NAND write from U-Boot's bad-block map -- flash from Linux.
CONFIG_DM_MTD=y
CONFIG_MTD_SPI_NAND=y
CONFIG_CMD_MTD=y

CONFIG_USE_BOOTCOMMAND=y
# SD first, NAND as the fallback. Order is deliberate: the SD card is the
# recovery path, so an inserted card must always win over whatever is on the
# NAND. The SD branch is byte-identical to what shipped before this fallback
# existed.
#
# The NAND branch sets its own bootargs because the root differs: a squashfs on
# mtdblock2 with a UBIFS overlay on mtd3 (overlaymtd=3), unioned by /preinit.
# Note musb_hdrc.use_dma=0 is repeated and is LOAD-BEARING -- without it wired
# CarPlay dies on silent bulk-OUT loss (docs/musb-dma-fix-plan.md).
#
# `mtd read` uses raw offsets against the whole-chip device rather than a
# partition name: U-Boot's device tree comes from dts/upstream and has no
# partitions node, so it sees one "spi-nand0". 0x80000 is where kernel.itb
# lives; 0x580000 is its 5.5 MiB partition size.
#
# 0x81000000 IS NOT ARBITRARY -- DO NOT LOWER IT. The FIT buffer must not
# overlap the load address of any NON-KERNEL sub-image, because boot/image-fit.c
# refuses the boot outright:
#
#     if (image_type != IH_TYPE_KERNEL &&
#         load < image_end && load_end > image_start) {
#             printf("Error: %s overwritten\n", prop_name);
#
# The buffer spans [addr, addr + 0x580000). This first read used 0x80800000,
# which spans 0x80800000-0x80D80000 and therefore swallows the fdt's own load
# address of 0x80C00000 (kernel.its), giving on a real boot:
#
#     Error: fdt overwritten
#     Could not find a valid device tree
#
# The kernel sub-image is exempt from that test, which is why it loaded and
# verified fine and only the fdt tripped it -- an easy failure to misread as a
# problem with the device tree itself. At 0x81000000 the buffer sits entirely
# above the fdt, which is also exactly what the vendor bootloader does
# (kernel_addr_r=0x81000000). Any new address must stay above 0x80C00000 plus
# the fdt size, and below the top of the 64 MiB of DRAM.
CONFIG_BOOTCOMMAND="if load mmc 0:1 0x80008000 zImage; then load mmc 0:1 0x80C00000 suniv-f1c200s-lctech-pi.dtb; bootz 0x80008000 - 0x80C00000; fi; echo 'No SD kernel -- booting from NAND'; setenv bootargs 'console=ttyS0,115200 panic=5 rootwait init=/preinit root=/dev/mtdblock2 rootfstype=squashfs overlaymtd=3 musb_hdrc.use_dma=0'; mtd read spi-nand0 0x81000000 0x80000 0x580000 && bootm 0x81000000"
