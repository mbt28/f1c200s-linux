From: mbt28 <btekbas@gmail.com>
Subject: [PATCH] drm/sun4i: let the writeback encoder clone the TCON's

The writeback connector (0044) shares the CRTC with the TCON's encoder,
but neither encoder listed the other in possible_clones, so the atomic
helpers refused every writeback job: "crtc62 failed valid clone check for
mask 0x3", EINVAL to user space.

After all the components are bound, mark each writeback (virtual) encoder
and every encoder on its CRTCs as clones of each other. And since the
writeback encoder is registered first, have sun4i_crtc_get_encoder() skip
it: the TCON programs its mux from the encoder type it returns.
---
diff --git a/drivers/gpu/drm/sun4i/sun4i_crtc.c b/drivers/gpu/drm/sun4i/sun4i_crtc.c
--- a/drivers/gpu/drm/sun4i/sun4i_crtc.c
+++ b/drivers/gpu/drm/sun4i/sun4i_crtc.c
@@ -38,8 +38,10 @@
 {
 	struct drm_encoder *encoder;
 
+	/* the writeback connector's virtual encoder is not on the mux */
 	drm_for_each_encoder(encoder, crtc->dev)
-		if (encoder->crtc == crtc)
+		if (encoder->crtc == crtc &&
+		    encoder->encoder_type != DRM_MODE_ENCODER_VIRTUAL)
 			return encoder;
 
 	return NULL;
diff --git a/drivers/gpu/drm/sun4i/sun4i_drv.c b/drivers/gpu/drm/sun4i/sun4i_drv.c
--- a/drivers/gpu/drm/sun4i/sun4i_drv.c
+++ b/drivers/gpu/drm/sun4i/sun4i_drv.c
@@ -18,6 +18,7 @@
 #include <drm/clients/drm_client_setup.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_drv.h>
+#include <drm/drm_encoder.h>
 #include <drm/drm_fbdev_dma.h>
 #include <drm/drm_gem_dma_helper.h>
 #include <drm/drm_module.h>
@@ -58,6 +59,28 @@
 	DRM_FBDEV_DMA_DRIVER_OPS,
 };
 
+/*
+ * The writeback connector's encoder runs next to the TCON's on the same
+ * CRTC: without this the atomic clone check refuses every writeback job.
+ */
+static void sun4i_drv_set_writeback_clones(struct drm_device *drm)
+{
+	struct drm_encoder *wb, *encoder;
+
+	drm_for_each_encoder(wb, drm) {
+		if (wb->encoder_type != DRM_MODE_ENCODER_VIRTUAL)
+			continue;
+
+		drm_for_each_encoder(encoder, drm) {
+			if (!(encoder->possible_crtcs & wb->possible_crtcs))
+				continue;
+			wb->possible_clones |= drm_encoder_mask(encoder);
+			encoder->possible_clones |= drm_encoder_mask(wb) |
+						    drm_encoder_mask(encoder);
+		}
+	}
+}
+
 static int sun4i_drv_bind(struct device *dev)
 {
 	struct drm_device *drm;
@@ -93,6 +116,8 @@
 		goto cleanup_mode_config;
 	}
 
+	sun4i_drv_set_writeback_clones(drm);
+
 	/* drm_vblank_init calls kcalloc, which can fail */
 	ret = drm_vblank_init(drm, drm->mode_config.num_crtc);
 	if (ret)
