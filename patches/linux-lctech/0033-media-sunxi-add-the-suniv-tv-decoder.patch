+static const char * const tvd_chroma_enh_menu[] = {
+	"Off",
+	"Mild",
+	"Low",
+	"Middle",
+	"High",
+};
+
+static const struct v4l2_ctrl_config tvd_chroma_enh_ctrl = {
+	.ops = &tvd_ctrl_ops,
+	.id = V4L2_CID_SUN4I_TVD_CHROMA_ENH,
+	.name = "Chroma Enhance",
+	.type = V4L2_CTRL_TYPE_MENU,
+	.max = ARRAY_SIZE(tvd_chroma_enh_menu) - 1,
+	.def = 0,
+	.qmenu = tvd_chroma_enh_menu,
+};
+
+static const struct v4l2_ctrl_config tvd_chroma_gain_ctrl = {
+	.ops = &tvd_ctrl_ops,
+	.id = V4L2_CID_SUN4I_TVD_CHROMA_GAIN,
+	.name = "Chroma Gain",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.max = 255,
+	.step = 1,
+	.def = 0x93,
+};
+
+/*
+ * Window after hsync in which the decoder looks for the colour burst. The
+ * vendor end value (0x8a) never locked colour on a bench camera, which
+ * locked for every end value from 0x46 to 0x7c: the default is the middle.
+ */
+static const struct v4l2_ctrl_config tvd_burst_start_ctrl = {
+	.ops = &tvd_ctrl_ops,
+	.id = V4L2_CID_SUN4I_TVD_BURST_START,
+	.name = "Burst Gate Start",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.max = 255,
+	.step = 1,
+	.def = 0x32,
+};
+
+static const struct v4l2_ctrl_config tvd_burst_end_ctrl = {
+	.ops = &tvd_ctrl_ops,
+	.id = V4L2_CID_SUN4I_TVD_BURST_END,
+	.name = "Burst Gate End",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.max = 255,
+	.step = 1,
+	.def = 0x60,
+};
+
+static int tvd_init_ctrls(struct sun4i_tvd *tvd)
+{
+	struct v4l2_ctrl_handler *hdl = &tvd->ctrls;
+
+	/*
+	 * The handler keeps its own lock: the ioctl core already holds
+	 * tvd->lock (vdev->lock) when it enters the control code. Order is
+	 * always tvd->lock, then the handler lock.
+	 */
+	v4l2_ctrl_handler_init(hdl, 11);
+	v4l2_ctrl_new_std(hdl, &tvd_ctrl_ops, V4L2_CID_BRIGHTNESS, 0, 255, 1, 0x20);
+	/* 0x80 = unity gain (the vendor default 0x68 is 0.8x, a dim picture) */
+	v4l2_ctrl_new_std(hdl, &tvd_ctrl_ops, V4L2_CID_CONTRAST, 0, 255, 1, 0x80);
+	v4l2_ctrl_new_std(hdl, &tvd_ctrl_ops, V4L2_CID_SHARPNESS, 0, 255, 1, 0x20);
+	tvd->saturation = v4l2_ctrl_new_std(hdl, &tvd_ctrl_ops,
+					    V4L2_CID_SATURATION, 0, 255, 1,
+					    tvd->std->saturation);
+	v4l2_ctrl_new_std(hdl, &tvd_ctrl_ops, V4L2_CID_HUE, -128, 127, 1, 0);
+	tvd->chroma_gain = v4l2_ctrl_new_custom(hdl, &tvd_chroma_gain_ctrl, NULL);
+	v4l2_ctrl_new_custom(hdl, &tvd_chroma_enh_ctrl, NULL);
+	v4l2_ctrl_new_custom(hdl, &tvd_burst_start_ctrl, NULL);
+	v4l2_ctrl_new_custom(hdl, &tvd_burst_end_ctrl, NULL);
+	v4l2_ctrl_new_custom(hdl, &tvd_blue_screen_ctrl, NULL);
+	tvd->comb = v4l2_ctrl_new_custom(hdl, &tvd_comb_ctrl, NULL);
+	if (hdl->error) {
+		int ret = hdl->error;
+
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+	tvd->v4l2_dev.ctrl_handler = hdl;
+	return 0;
+}
