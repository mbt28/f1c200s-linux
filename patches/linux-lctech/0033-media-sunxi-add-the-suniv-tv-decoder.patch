+/* ---- ioctls ----------------------------------------------------------- */
+
+static int tvd_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, KBUILD_MODNAME, sizeof(cap->driver));
+	strscpy(cap->card, "Allwinner suniv TV decoder", sizeof(cap->card));
+	return 0;
+}
+
+static int tvd_enum_fmt(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	static const u32 formats[] = { V4L2_PIX_FMT_NV12, V4L2_PIX_FMT_NV16 };
+
+	if (f->index >= ARRAY_SIZE(formats))
+		return -EINVAL;
+	f->pixelformat = formats[f->index];
+	return 0;
+}
+
+static int tvd_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+	struct v4l2_pix_format *pix = &f->fmt.pix;
+
+	if (pix->pixelformat != V4L2_PIX_FMT_NV16)
+		pix->pixelformat = V4L2_PIX_FMT_NV12;
+	tvd_fill_fmt(pix, tvd->std);
+	return 0;
+}
+
+static int tvd_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	f->fmt.pix = tvd->fmt;
+	return 0;
+}
+
+static int tvd_s_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	if (vb2_is_busy(&tvd->queue))
+		return -EBUSY;
+	tvd_try_fmt(file, priv, f);
+	tvd->fmt = f->fmt.pix;
+	return 0;
+}
+
+static int tvd_enum_framesizes(struct file *file, void *priv,
+			       struct v4l2_frmsizeenum *fsize)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	if (fsize->index ||
+	    (fsize->pixel_format != V4L2_PIX_FMT_NV12 &&
+	     fsize->pixel_format != V4L2_PIX_FMT_NV16))
+		return -EINVAL;
+	fsize->type = V4L2_FRMSIZE_TYPE_DISCRETE;
+	fsize->discrete.width = TVD_WIDTH;
+	fsize->discrete.height = tvd->std->height;
+	return 0;
+}
+
+/* The frame rate is the standard's own; there is nothing to choose. */
+static int tvd_enum_frameintervals(struct file *file, void *priv,
+				   struct v4l2_frmivalenum *fival)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	if (fival->index ||
+	    (fival->pixel_format != V4L2_PIX_FMT_NV12 &&
+	     fival->pixel_format != V4L2_PIX_FMT_NV16) ||
+	    fival->width != TVD_WIDTH || fival->height != tvd->std->height)
+		return -EINVAL;
+	fival->type = V4L2_FRMIVAL_TYPE_DISCRETE;
+	fival->discrete = tvd->std->frame_period;
+	return 0;
+}
+
+static int tvd_enum_input(struct file *file, void *priv, struct v4l2_input *inp)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+	u32 status;
+
+	if (inp->index >= TVD_NUM_INPUTS)
+		return -EINVAL;
+
+	inp->type = V4L2_INPUT_TYPE_CAMERA;
+	inp->std = TVD_STDS;
+	inp->capabilities = V4L2_IN_CAP_STD;
+	snprintf(inp->name, sizeof(inp->name), "Composite %u", inp->index);
+
+	/* only the selected input is sampled */
+	if (inp->index == tvd->input && tvd->users) {
+		status = tvd_read(tvd, TVD_STATUS);
+		if (status & TVD_STATUS_NO_SIGNAL)
+			inp->status |= V4L2_IN_ST_NO_SIGNAL;
+		if (!(status & TVD_STATUS_H_LOCK))
+			inp->status |= V4L2_IN_ST_NO_H_LOCK;
+		if (!(status & TVD_STATUS_V_LOCK))
+			inp->status |= V4L2_IN_ST_NO_V_LOCK;
+		if (!(status & TVD_STATUS_C_LOCK))
+			inp->status |= V4L2_IN_ST_NO_COLOR;
+	}
+	return 0;
+}
+
+static int tvd_g_input(struct file *file, void *priv, unsigned int *i)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	*i = tvd->input;
+	return 0;
+}
+
+static int tvd_s_input(struct file *file, void *priv, unsigned int i)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	if (i >= TVD_NUM_INPUTS)
+		return -EINVAL;
+	tvd->input = i;
+	if (tvd->users)
+		tvd_update(tvd, TVD_ADC_INPUT, TVD_ADC_INPUT_TVIN1,
+			   i ? TVD_ADC_INPUT_TVIN1 : 0);
+	return 0;
+}
+
+static int tvd_g_std(struct file *file, void *priv, v4l2_std_id *std)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	*std = tvd->std->std;
+	return 0;
+}
+
+static int tvd_s_std(struct file *file, void *priv, v4l2_std_id id)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+	const struct tvd_std *std = tvd_find_std(id);
+
+	if (!std)
+		return -EINVAL;
+	if (std == tvd->std)
+		return 0;
+	if (vb2_is_busy(&tvd->queue))
+		return -EBUSY;
+
+	tvd->std = std;
+	tvd_fill_fmt(&tvd->fmt, std);
+	if (tvd->users)
+		tvd_setup_decoder(tvd);
+	/* saturation and chroma gain have per-standard vendor defaults */
+	v4l2_ctrl_modify_range(tvd->saturation, 0, 255, 1, std->saturation);
+	v4l2_ctrl_s_ctrl(tvd->saturation, std->saturation);
+	v4l2_ctrl_modify_range(tvd->chroma_gain, 0, 255, 1, std->chroma_gain);
+	v4l2_ctrl_s_ctrl(tvd->chroma_gain, std->chroma_gain);
+	if (tvd->users)
+		v4l2_ctrl_handler_setup(&tvd->ctrls);
+	return 0;
+}
+
+static int tvd_querystd(struct file *file, void *priv, v4l2_std_id *std)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+	u32 status = tvd_read(tvd, TVD_STATUS);
+
+	if ((status & TVD_STATUS_NO_SIGNAL) || !(status & TVD_STATUS_V_LOCK)) {
+		*std = V4L2_STD_UNKNOWN;
+		return 0;
+	}
+	if (status & TVD_STATUS_625)
+		*std &= (status & TVD_STATUS_SECAM) ? V4L2_STD_SECAM :
+			V4L2_STD_PAL | V4L2_STD_PAL_Nc;
+	else
+		*std &= (status & TVD_STATUS_PAL) ? V4L2_STD_PAL_M :
+			V4L2_STD_NTSC_M;
+	return 0;
+}
+
+static int tvd_g_parm(struct file *file, void *priv, struct v4l2_streamparm *a)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+
+	if (a->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
+		return -EINVAL;
+	a->parm.capture.readbuffers = 0;
+	a->parm.capture.capability = V4L2_CAP_TIMEPERFRAME;
+	a->parm.capture.timeperframe = tvd->std->frame_period;
+	return 0;
+}
+
+static int tvd_subscribe_event(struct v4l2_fh *fh,
+			       const struct v4l2_event_subscription *sub)
+{
+	if (sub->type == V4L2_EVENT_CTRL)
+		return v4l2_ctrl_subscribe_event(fh, sub);
+	return -EINVAL;
+}
+
+static const struct v4l2_ioctl_ops tvd_ioctl_ops = {
+	.vidioc_querycap = tvd_querycap,
+	.vidioc_enum_fmt_vid_cap = tvd_enum_fmt,
+	.vidioc_try_fmt_vid_cap = tvd_try_fmt,
+	.vidioc_g_fmt_vid_cap = tvd_g_fmt,
+	.vidioc_s_fmt_vid_cap = tvd_s_fmt,
+	.vidioc_enum_framesizes = tvd_enum_framesizes,
+	.vidioc_enum_frameintervals = tvd_enum_frameintervals,
+	.vidioc_enum_input = tvd_enum_input,
+	.vidioc_g_input = tvd_g_input,
+	.vidioc_s_input = tvd_s_input,
+	.vidioc_g_std = tvd_g_std,
+	.vidioc_s_std = tvd_s_std,
+	.vidioc_querystd = tvd_querystd,
+	.vidioc_g_parm = tvd_g_parm,
+	.vidioc_s_parm = tvd_g_parm,
+
+	.vidioc_reqbufs = vb2_ioctl_reqbufs,
+	.vidioc_create_bufs = vb2_ioctl_create_bufs,
+	.vidioc_prepare_buf = vb2_ioctl_prepare_buf,
+	.vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_qbuf = vb2_ioctl_qbuf,
+	.vidioc_dqbuf = vb2_ioctl_dqbuf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
+	.vidioc_streamon = vb2_ioctl_streamon,
+	.vidioc_streamoff = vb2_ioctl_streamoff,
+
+	.vidioc_log_status = v4l2_ctrl_log_status,
+	.vidioc_subscribe_event = tvd_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+/* The decoder runs (and status/QUERYSTD work) while the device is open. */
+static int tvd_open(struct file *file)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+	int ret;
+
+	mutex_lock(&tvd->lock);
+	ret = v4l2_fh_open(file);
+	if (!ret && v4l2_fh_is_singular_file(file)) {
+		ret = tvd_power_on(tvd);
+		if (ret)
+			v4l2_fh_release(file);
+	}
+	mutex_unlock(&tvd->lock);
+	return ret;
+}
+
+static int tvd_release(struct file *file)
+{
+	struct sun4i_tvd *tvd = video_drvdata(file);
+	bool last;
+	int ret;
+
+	mutex_lock(&tvd->lock);
+	last = v4l2_fh_is_singular_file(file);
+	ret = _vb2_fop_release(file, NULL);
+	if (last)
+		tvd_power_off(tvd);
+	mutex_unlock(&tvd->lock);
+	return ret;
+}
+
+static const struct v4l2_file_operations tvd_fops = {
+	.owner = THIS_MODULE,
+	.open = tvd_open,
+	.release = tvd_release,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = vb2_fop_mmap,
+	.poll = vb2_fop_poll,
+};
+
+/* ---- probe ------------------------------------------------------------ */
+
+static int tvd_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sun4i_tvd *tvd;
+	struct video_device *vdev;
+	struct vb2_queue *q;
+	unsigned long rate;
+	int irq, ret;
+
+	tvd = devm_kzalloc(dev, sizeof(*tvd), GFP_KERNEL);
+	if (!tvd)
+		return -ENOMEM;
+	tvd->dev = dev;
+	mutex_init(&tvd->lock);
+	spin_lock_init(&tvd->qlock);
+	INIT_LIST_HEAD(&tvd->queued);
+
+	tvd->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(tvd->regs))
+		return PTR_ERR(tvd->regs);
+
+	tvd->bus_clk = devm_clk_get(dev, "bus");
+	if (IS_ERR(tvd->bus_clk))
+		return dev_err_probe(dev, PTR_ERR(tvd->bus_clk), "bus clock\n");
+	tvd->mod_clk = devm_clk_get(dev, "mod");
+	if (IS_ERR(tvd->mod_clk))
+		return dev_err_probe(dev, PTR_ERR(tvd->mod_clk), "mod clock\n");
+	tvd->ram_clk = devm_clk_get(dev, "ram");
+	if (IS_ERR(tvd->ram_clk))
+		return dev_err_probe(dev, PTR_ERR(tvd->ram_clk), "ram clock\n");
+	tvd->rst = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(tvd->rst))
+		return dev_err_probe(dev, PTR_ERR(tvd->rst), "reset\n");
+
+	/* a divider of PLL_VIDEO; the decoder only locks at exactly 27 MHz */
+	ret = clk_set_rate(tvd->mod_clk, TVD_MOD_RATE);
+	rate = clk_get_rate(tvd->mod_clk);
+	if (ret || rate != TVD_MOD_RATE)
+		dev_warn(dev, "module clock %lu Hz, need %u (PLL_VIDEO must be 297 or 270 MHz)\n",
+			 rate, TVD_MOD_RATE);
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	tvd->irq = irq;
+	ret = devm_request_irq(dev, irq, tvd_irq, 0, dev_name(dev), tvd);
+	if (ret)
+		return ret;
+
+	tvd->std = tvd_find_std(V4L2_STD_PAL);
+	tvd->fmt.pixelformat = V4L2_PIX_FMT_NV12;
+	tvd_fill_fmt(&tvd->fmt, tvd->std);
+
+	ret = v4l2_device_register(dev, &tvd->v4l2_dev);
+	if (ret)
+		return ret;
+	ret = tvd_init_ctrls(tvd);
+	if (ret)
+		goto err_v4l2;
+
+	q = &tvd->queue;
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = tvd;
+	q->buf_struct_size = sizeof(struct tvd_buffer);
+	q->ops = &tvd_vb2_ops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &tvd->lock;
+	q->dev = dev;
+	/* one buffer being written plus one latched for the next frame */
+	q->min_queued_buffers = 2;
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto err_ctrls;
+
+	vdev = &tvd->vdev;
+	strscpy(vdev->name, "sun4i-tvd", sizeof(vdev->name));
+	vdev->fops = &tvd_fops;
+	vdev->ioctl_ops = &tvd_ioctl_ops;
+	vdev->v4l2_dev = &tvd->v4l2_dev;
+	vdev->queue = q;
+	vdev->lock = &tvd->lock;
+	vdev->tvnorms = TVD_STDS;
+	vdev->release = video_device_release_empty;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, tvd);
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_ctrls;
+
+	platform_set_drvdata(pdev, tvd);
+	dev_info(dev, "registered %s, module clock %lu Hz\n",
+		 video_device_node_name(vdev), rate);
+	return 0;
+
+err_ctrls:
+	v4l2_ctrl_handler_free(&tvd->ctrls);
+err_v4l2:
+	v4l2_device_unregister(&tvd->v4l2_dev);
+	return ret;
+}
+
+static void tvd_remove(struct platform_device *pdev)
+{
+	struct sun4i_tvd *tvd = platform_get_drvdata(pdev);
+
+	video_unregister_device(&tvd->vdev);
+	v4l2_ctrl_handler_free(&tvd->ctrls);
+	v4l2_device_unregister(&tvd->v4l2_dev);
+}
+
+static const struct of_device_id tvd_of_match[] = {
+	{ .compatible = "allwinner,suniv-f1c100s-tvd" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tvd_of_match);
+
+static struct platform_driver tvd_driver = {
+	.probe = tvd_probe,
+	.remove = tvd_remove,
+	.driver = {
+		.name = "sun4i-tvd",
+		.of_match_table = tvd_of_match,
+	},
+};
+module_platform_driver(tvd_driver);
+
+MODULE_DESCRIPTION("Allwinner suniv TV decoder (composite video capture)");
+MODULE_LICENSE("GPL");
