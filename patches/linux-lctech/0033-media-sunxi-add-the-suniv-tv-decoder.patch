--- a/drivers/media/platform/sunxi/Makefile
+++ b/drivers/media/platform/sunxi/Makefile
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 
 obj-y		+= sun4i-csi/
+obj-y		+= sun4i-tvd/
 obj-y		+= sun6i-csi/
 obj-y		+= sun6i-mipi-csi2/
 obj-y		+= sun8i-a83t-mipi-csi2/
--- a/drivers/media/platform/sunxi/sun4i-tvd/Kconfig
+++ b/drivers/media/platform/sunxi/sun4i-tvd/Kconfig
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config VIDEO_SUN4I_TVD
+	tristate "Allwinner suniv (F1C100s/F1C200s) TV decoder support"
+	depends on V4L_PLATFORM_DRIVERS
+	depends on VIDEO_DEV && COMMON_CLK && RESET_CONTROLLER && HAS_DMA
+	depends on ARCH_SUNXI || COMPILE_TEST
+	select VIDEOBUF2_DMA_CONTIG
+	help
+	  V4L2 capture driver for the composite video (CVBS) decoder of the
+	  Allwinner F1C100s and F1C200s, with two inputs (TVIN0/TVIN1) and
+	  NTSC/PAL/SECAM support.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called sun4i_tvd.
--- a/drivers/media/platform/sunxi/sun4i-tvd/Makefile
+++ b/drivers/media/platform/sunxi/sun4i-tvd/Makefile
@@ -0,0 +1 @@
+obj-$(CONFIG_VIDEO_SUN4I_TVD) += sun4i_tvd.o
--- a/drivers/media/platform/sunxi/sun4i-tvd/sun4i_tvd.c
+++ b/drivers/media/platform/sunxi/sun4i-tvd/sun4i_tvd.c
@@ -0,0 +1,1139 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner suniv (F1C100s/F1C200s) TV decoder (TVD): composite video capture.
+ *
+ * The block is undocumented. It is the A20 TVD decoder core behind a
+ * different register layout with one DMA channel and two inputs (TVIN0/1).
+ * The register meanings come from bench measurements on an F1C200s and from
+ * the public reverse-engineering notes for the F1C100s (F1C100s_info, register
+ * dumps of the vendor Melis SDK capturing, and its decompiled sys_tvd).
+ *
+ * The decoder needs a 27 MHz module clock, so PLL_VIDEO must run at 297 (or
+ * 270) MHz.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-v4l2.h>
+
+#define TVD_EN				0x000
+#define TVD_EN_DECODER			BIT(0)
+#define TVD_EN_RESET			GENMASK(12, 8)	/* pulsed by the vendor init */
+#define TVD_EN_COMB_3D			BIT(4)
+#define TVD_MODE			0x008	/* [14:12] colour standard (V40 COLOR_STD) */
+#define TVD_MODE_COMB_2D		BIT(0)	/* 1: 2D comb, 0: 3D comb */
+/* [24] sharpen enable, [23:16] sharpness, [15:8] brightness, [7:0] contrast (0x80 = 1x) */
+#define TVD_LUMA			0x00c
+#define TVD_LUMA_INIT			0x00200000
+/* [21:20] chroma enhance strength, [16] enhance enable, [15:8] hue, [7:0] saturation */
+#define TVD_CHROMA			0x010
+#define TVD_CHROMA_INIT			0x00300000
+#define TVD_CHROMA_ENH_EN		BIT(16)
+#define TVD_CHROMA_ENH_STRENGTH		GENMASK(21, 20)
+#define TVD_PRESCALE			0x014
+#define TVD_CHROMA_FREQ			0x018	/* subcarrier / 27 MHz * 2^32 */
+#define TVD_WINDOW			0x01c
+#define TVD_3D_CTL			0x040
+#define TVD_3D_CTL_INIT			0x04000310	/* vendor constant */
+#define TVD_3D_LATCH			0x048
+#define TVD_3D_LATCH_ARM		0x04040001	/* bits 26 and 18 self-clear */
+#define TVD_3D_START			0x04c
+#define TVD_3D_END			0x050
+#define TVD_3D_SIZE			0x054
+#define TVD_DMA_Y			0x080
+#define TVD_DMA_C			0x084
+#define TVD_DMA_CFG			0x088
+#define TVD_DMA_CFG_EN			BIT(0)
+#define TVD_DMA_CFG_YUV422		BIT(4)
+#define TVD_DMA_CFG_SIZE_VALID		BIT(26)
+#define TVD_DMA_CFG_ADDR_VALID		BIT(28)	/* latched at the frame boundary, self-clears */
+#define TVD_DMA_SIZE			0x08c	/* [26:16] lines per field, [11:0] width */
+#define TVD_DMA_STRIDE			0x090
+#define TVD_IRQ_STATUS			0x094	/* write 1 to clear */
+#define TVD_IRQ_EN			0x09c
+#define TVD_IRQ_FRAME_DONE		BIT(24)
+#define TVD_ADC_INPUT			0xe04
+#define TVD_ADC_INPUT_INIT		0x8002aaa8
+#define TVD_ADC_INPUT_TVIN1		BIT(0)
+#define TVD_ADC_CTL			0xe2c
+#define TVD_STATUS			0xe40
+#define TVD_STATUS_NO_SIGNAL		BIT(0)
+#define TVD_STATUS_H_LOCK		BIT(1)
+#define TVD_STATUS_V_LOCK		BIT(2)
+#define TVD_STATUS_C_LOCK		BIT(3)
+#define TVD_STATUS_PAL			BIT(16)
+#define TVD_STATUS_SECAM		BIT(17)
+#define TVD_STATUS_625			BIT(18)
+/* burst gate (V40 TVD_CLOCK1 fields): [23:16] end, [15:8] start */
+#define TVD_BURST_GATE			0xf10
+#define TVD_BURST_GATE_END		GENMASK(23, 16)
+#define TVD_BURST_GATE_START		GENMASK(15, 8)
+#define TVD_BLUE			0xf14
+#define TVD_BLUE_MODE			GENMASK(5, 4)
+#define TVD_CHROMA_AGC			0xf1c	/* [23:16] chroma gain (vendor chrom_gain) */
+#define TVD_CHROMA_GAIN			GENMASK(23, 16)
+
+#define TVD_MOD_RATE			27000000
+#define TVD_WIDTH			720
+#define TVD_NUM_INPUTS			2
+/* Field memory of the 3D comb filter: the decoder DMAs into it on its own. */
+#define TVD_3D_BUF_SIZE			SZ_2M
+
+#define TVD_STDS	(V4L2_STD_NTSC_M | V4L2_STD_PAL | V4L2_STD_PAL_M | \
+			 V4L2_STD_PAL_Nc | V4L2_STD_SECAM)
+
+#define V4L2_CID_SUN4I_TVD_BLUE_SCREEN	(V4L2_CID_USER_SUN4I_TVD_BASE + 0)
+#define V4L2_CID_SUN4I_TVD_COMB_3D	(V4L2_CID_USER_SUN4I_TVD_BASE + 1)
+#define V4L2_CID_SUN4I_TVD_CHROMA_ENH	(V4L2_CID_USER_SUN4I_TVD_BASE + 2)
+#define V4L2_CID_SUN4I_TVD_CHROMA_GAIN	(V4L2_CID_USER_SUN4I_TVD_BASE + 3)
+#define V4L2_CID_SUN4I_TVD_BURST_START	(V4L2_CID_USER_SUN4I_TVD_BASE + 4)
+#define V4L2_CID_SUN4I_TVD_BURST_END	(V4L2_CID_USER_SUN4I_TVD_BASE + 5)
+
+struct tvd_reg {
+	u16 reg;
+	u32 val;
+};
+
+struct tvd_std {
+	v4l2_std_id std;
+	unsigned int height;
+	u8 saturation;
+	u8 chroma_gain;
+	struct v4l2_fract frame_period;
+	const struct tvd_reg *regs;
+	unsigned int num_regs;
+};
+
+/* Registered before every standard's own table. */
+static const struct tvd_reg tvd_common_regs[] = {
+	{ TVD_PRESCALE, 0x20000000 },
+	{ 0xf24, 0x0682810a }, { 0xf28, 0x00006440 }, { 0xf4c, 0x0e70106c },
+	{ 0xf54, 0x00000000 }, { 0xf58, 0x00000082 }, { 0xf6c, 0x00fffad0 },
+	{ 0xf70, 0x0000a010 },
+};
+
+static const struct tvd_reg tvd_ntsc_regs[] = {
+	{ TVD_MODE, 0x00010001 }, { TVD_CHROMA_FREQ, 0x21f07c1f },
+	{ TVD_WINDOW, 0x00820022 },
+	{ 0xf08, 0x00590100 }, { 0xf0c, 0x00000010 }, { 0xf10, 0x008a32dd },
+	{ TVD_BLUE, 0x800000a0 }, { 0xf1c, 0x008a0000 }, { 0xf2c, 0x0000cb74 },
+	{ 0xf44, 0x00004632 }, { 0xf74, 0x000003c3 }, { 0xf80, 0x00500000 },
+	{ 0xf84, 0x00610000 },
+};
+
+static const struct tvd_reg tvd_pal_regs[] = {
+	{ TVD_MODE, 0x01101001 }, { TVD_CHROMA_FREQ, 0x2a098acb },
+	{ TVD_WINDOW, 0x0087002a },
+	{ 0xf08, 0x11590902 }, { 0xf0c, 0x00000016 }, { 0xf10, 0x008a32ec },
+	{ TVD_BLUE, 0x800000a0 }, { 0xf1c, 0x00930000 }, { 0xf2c, 0x00000d74 },
+	{ 0xf44, 0x0000412d }, { 0xf74, 0x00000343 }, { 0xf80, 0x00500000 },
+	{ 0xf84, 0x00c10000 },
+};
+
+/* PAL-M, PAL-Nc and SECAM: vendor values, not verified on hardware. */
+static const struct tvd_reg tvd_pal_m_regs[] = {
+	{ TVD_MODE, 0x00002001 }, { TVD_CHROMA_FREQ, 0x21e6efe3 },
+	{ TVD_WINDOW, 0x00820022 },
+	{ 0xf08, 0x00590100 }, { 0xf0c, 0x00000040 }, { 0xf10, 0x008a32dd },
+	{ TVD_BLUE, 0x800000a0 }, { 0xf1c, 0x008a0000 }, { 0xf2c, 0x0000cb74 },
+	{ 0xf44, 0x00004632 }, { 0xf74, 0x000003c3 }, { 0xf80, 0x00500000 },
+	{ 0xf84, 0x00610000 },
+};
+
+static const struct tvd_reg tvd_pal_nc_regs[] = {
+	{ TVD_MODE, 0x01103001 }, { TVD_CHROMA_FREQ, 0x21f69446 },
+	{ TVD_WINDOW, 0x00870026 },
+	{ 0xf08, 0x11590902 }, { 0xf0c, 0x00000040 }, { 0xf10, 0x008a32ec },
+	{ TVD_BLUE, 0x800000a0 }, { 0xf1c, 0x00dc0000 }, { 0xf2c, 0x00000d74 },
+	{ 0xf44, 0x00004632 }, { 0xf74, 0x00000343 }, { 0xf80, 0x00500000 },
+	{ 0xf84, 0x00c10000 },
+};
+
+static const struct tvd_reg tvd_secam_regs[] = {
+	{ TVD_MODE, 0x01104001 }, { TVD_CHROMA_FREQ, 0x28a33bb2 },
+	{ TVD_WINDOW, 0x00870026 },
+	{ 0xf08, 0x11590902 }, { 0xf0c, 0x00000040 }, { 0xf10, 0x008a32ec },
+	{ TVD_BLUE, 0x800000a0 }, { 0xf1c, 0x00dc0000 }, { 0xf2c, 0x00000d74 },
+	{ 0xf44, 0x00005036 }, { 0xf74, 0x00000343 }, { 0xf80, 0x00500000 },
+	{ 0xf84, 0x00c10000 },
+};
+
+#define TVD_STD(_std, _h, _sat, _cgain, _num, _den, _regs)		\
+	{ .std = _std, .height = _h, .saturation = _sat,		\
+	  .chroma_gain = _cgain, .frame_period = { _num, _den },	\
+	  .regs = _regs, .num_regs = ARRAY_SIZE(_regs) }
+
+/* First match wins, so the specific standards go before V4L2_STD_PAL. */
+static const struct tvd_std tvd_stds[] = {
+	TVD_STD(V4L2_STD_NTSC_M, 480, 0x80, 0x8a, 1001, 30000, tvd_ntsc_regs),
+	TVD_STD(V4L2_STD_PAL_M, 480, 0x80, 0x8a, 1001, 30000, tvd_pal_m_regs),
+	TVD_STD(V4L2_STD_PAL_Nc, 576, 0x80, 0xdc, 1, 25, tvd_pal_nc_regs),
+	TVD_STD(V4L2_STD_SECAM, 576, 0x80, 0xdc, 1, 25, tvd_secam_regs),
+	TVD_STD(V4L2_STD_PAL, 576, 0x50, 0x93, 1, 25, tvd_pal_regs),
+};
+
+struct tvd_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+};
+
+struct sun4i_tvd {
+	struct device *dev;
+	void __iomem *regs;
+	struct clk *bus_clk;
+	struct clk *mod_clk;
+	struct clk *ram_clk;
+	struct reset_control *rst;
+	int irq;
+
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct vb2_queue queue;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *saturation;
+	struct v4l2_ctrl *chroma_gain;
+	struct v4l2_ctrl *comb;
+	/* serialises ioctls, open/release and the power state */
+	struct mutex lock;
+	unsigned int users;
+
+	const struct tvd_std *std;
+	unsigned int input;
+	struct v4l2_pix_format fmt;
+
+	void *comb_cpu;
+	dma_addr_t comb_dma;
+
+	/* protects the buffer bookkeeping below, shared with the IRQ handler */
+	spinlock_t qlock;
+	struct list_head queued;
+	struct tvd_buffer *active;	/* the DMA is writing this one */
+	struct tvd_buffer *pending;	/* latched at the next frame boundary */
+	unsigned int sequence;
+};
+
+static inline void tvd_write(struct sun4i_tvd *tvd, u32 reg, u32 val)
+{
+	writel(val, tvd->regs + reg);
+}
+
+static inline u32 tvd_read(struct sun4i_tvd *tvd, u32 reg)
+{
+	return readl(tvd->regs + reg);
+}
+
+static void tvd_update(struct sun4i_tvd *tvd, u32 reg, u32 mask, u32 val)
+{
+	tvd_write(tvd, reg, (tvd_read(tvd, reg) & ~mask) | (val & mask));
+}
+
+static const struct tvd_std *tvd_find_std(v4l2_std_id std)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(tvd_stds); i++)
+		if (std & tvd_stds[i].std)
+			return &tvd_stds[i];
+	return NULL;
+}
+
+static void tvd_fill_fmt(struct v4l2_pix_format *pix, const struct tvd_std *std)
+{
+	pix->width = TVD_WIDTH;
+	pix->height = std->height;
+	pix->field = V4L2_FIELD_INTERLACED;
+	pix->bytesperline = TVD_WIDTH;
+	if (pix->pixelformat == V4L2_PIX_FMT_NV16)
+		pix->sizeimage = pix->bytesperline * pix->height * 2;
+	else
+		pix->sizeimage = pix->bytesperline * pix->height * 3 / 2;
+	pix->colorspace = std->height == 576 ? V4L2_COLORSPACE_470_SYSTEM_BG :
+					       V4L2_COLORSPACE_SMPTE170M;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	pix->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+	pix->xfer_func = V4L2_XFER_FUNC_709;
+}
+
+/* Program the decoder for tvd->std and tvd->input. Called powered. */
+static void tvd_setup_decoder(struct sun4i_tvd *tvd)
+{
+	const struct tvd_std *std = tvd->std;
+	unsigned int i;
+
+	tvd_write(tvd, TVD_ADC_INPUT, TVD_ADC_INPUT_INIT |
+		  (tvd->input ? TVD_ADC_INPUT_TVIN1 : 0));
+	tvd_write(tvd, TVD_ADC_CTL, 0x00110000);
+	tvd_write(tvd, TVD_3D_CTL, TVD_3D_CTL_INIT);
+	/* the vendor sequence: everything off, then the reset bits pulsed */
+	tvd_write(tvd, TVD_EN, 0);
+	usleep_range(1000, 2000);
+	tvd_write(tvd, TVD_EN, TVD_EN_RESET);
+
+	for (i = 0; i < ARRAY_SIZE(tvd_common_regs); i++)
+		tvd_write(tvd, tvd_common_regs[i].reg, tvd_common_regs[i].val);
+	for (i = 0; i < std->num_regs; i++)
+		tvd_write(tvd, std->regs[i].reg, std->regs[i].val);
+	/*
+	 * Fields the controls do not own (sharpen enable, chroma enhance
+	 * strength) take the vendor values; the controls fill in the rest.
+	 * The tables leave TVD_MODE_COMB_2D set: the 3D comb filter runs
+	 * only while streaming, when it has field memory.
+	 */
+	tvd_write(tvd, TVD_LUMA, TVD_LUMA_INIT);
+	tvd_write(tvd, TVD_CHROMA, TVD_CHROMA_INIT);
+
+	tvd_write(tvd, TVD_EN, TVD_EN_DECODER);
+	tvd_write(tvd, TVD_ADC_CTL, 0x60000000);
+}
+
+static int tvd_power_on(struct sun4i_tvd *tvd)
+{
+	int ret;
+
+	if (tvd->users++)
+		return 0;
+
+	ret = clk_prepare_enable(tvd->bus_clk);
+	if (ret)
+		goto err;
+	ret = clk_prepare_enable(tvd->mod_clk);
+	if (ret)
+		goto err_bus;
+	ret = clk_prepare_enable(tvd->ram_clk);
+	if (ret)
+		goto err_mod;
+	ret = reset_control_deassert(tvd->rst);
+	if (ret)
+		goto err_ram;
+
+	tvd_setup_decoder(tvd);
+	/* the luma/chroma registers are written from the controls */
+	ret = v4l2_ctrl_handler_setup(&tvd->ctrls);
+	if (ret)
+		goto err_rst;
+	return 0;
+
+err_rst:
+	reset_control_assert(tvd->rst);
+err_ram:
+	clk_disable_unprepare(tvd->ram_clk);
+err_mod:
+	clk_disable_unprepare(tvd->mod_clk);
+err_bus:
+	clk_disable_unprepare(tvd->bus_clk);
+err:
+	tvd->users--;
+	return ret;
+}
+
+static void tvd_power_off(struct sun4i_tvd *tvd)
+{
+	if (--tvd->users)
+		return;
+
+	tvd_write(tvd, TVD_EN, 0);
+	reset_control_assert(tvd->rst);
+	clk_disable_unprepare(tvd->ram_clk);
+	clk_disable_unprepare(tvd->mod_clk);
+	clk_disable_unprepare(tvd->bus_clk);
+}
+
+/* ---- buffers ---------------------------------------------------------- */
+
+static struct tvd_buffer *to_tvd_buffer(struct vb2_v4l2_buffer *vbuf)
+{
+	return container_of(vbuf, struct tvd_buffer, vb);
+}
+
+/* Arm @buf for the next frame: the address is latched at the frame boundary. */
+static void tvd_program_buffer(struct sun4i_tvd *tvd, struct tvd_buffer *buf)
+{
+	dma_addr_t addr = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+
+	tvd_write(tvd, TVD_DMA_Y, addr);
+	tvd_write(tvd, TVD_DMA_C, addr + tvd->fmt.bytesperline * tvd->fmt.height);
+	tvd_update(tvd, TVD_DMA_CFG, TVD_DMA_CFG_ADDR_VALID, TVD_DMA_CFG_ADDR_VALID);
+}
+
+static struct tvd_buffer *tvd_next_buffer(struct sun4i_tvd *tvd)
+{
+	struct tvd_buffer *buf;
+
+	buf = list_first_entry_or_null(&tvd->queued, struct tvd_buffer, list);
+	if (buf)
+		list_del(&buf->list);
+	return buf;
+}
+
+static irqreturn_t tvd_irq(int irq, void *data)
+{
+	struct sun4i_tvd *tvd = data;
+	struct tvd_buffer *done = NULL;
+	bool dropped = false;
+	u32 status;
+
+	status = tvd_read(tvd, TVD_IRQ_STATUS);
+	if (!(status & TVD_IRQ_FRAME_DONE))
+		return IRQ_NONE;
+	tvd_write(tvd, TVD_IRQ_STATUS, status);
+
+	spin_lock(&tvd->qlock);
+	/*
+	 * At this frame boundary the frame just finished went to ->active and
+	 * the DMA latched ->pending for the next one. Without a pending buffer
+	 * it keeps writing ->active, so that frame is dropped instead.
+	 */
+	if (tvd->pending) {
+		/* NULL at the first boundary after start: nothing captured yet */
+		done = tvd->active;
+		tvd->active = tvd->pending;
+		tvd->pending = NULL;
+	} else {
+		dropped = true;
+	}
+	tvd->pending = tvd_next_buffer(tvd);
+	if (tvd->pending)
+		tvd_program_buffer(tvd, tvd->pending);
+
+	if (done) {
+		done->vb.vb2_buf.timestamp = ktime_get_ns();
+		done->vb.field = V4L2_FIELD_INTERLACED;
+		done->vb.sequence = tvd->sequence++;
+		vb2_buffer_done(&done->vb.vb2_buf, VB2_BUF_STATE_DONE);
+	} else if (dropped) {
+		/* a gap in the sequence numbers tells userspace */
+		tvd->sequence++;
+	}
+	spin_unlock(&tvd->qlock);
+
+	return IRQ_HANDLED;
+}
+
+static int tvd_queue_setup(struct vb2_queue *q, unsigned int *nbuffers,
+			   unsigned int *nplanes, unsigned int sizes[],
+			   struct device *alloc_devs[])
+{
+	struct sun4i_tvd *tvd = vb2_get_drv_priv(q);
+
+	if (*nplanes)
+		return sizes[0] < tvd->fmt.sizeimage ? -EINVAL : 0;
+	*nplanes = 1;
+	sizes[0] = tvd->fmt.sizeimage;
+	return 0;
+}
+
+static int tvd_buf_prepare(struct vb2_buffer *vb)
+{
+	struct sun4i_tvd *tvd = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (vb2_plane_size(vb, 0) < tvd->fmt.sizeimage)
+		return -EINVAL;
+	vb2_set_plane_payload(vb, 0, tvd->fmt.sizeimage);
+	return 0;
+}
+
+static void tvd_buf_queue(struct vb2_buffer *vb)
+{
+	struct sun4i_tvd *tvd = vb2_get_drv_priv(vb->vb2_queue);
+	struct tvd_buffer *buf = to_tvd_buffer(to_vb2_v4l2_buffer(vb));
+	unsigned long flags;
+
+	spin_lock_irqsave(&tvd->qlock, flags);
+	list_add_tail(&buf->list, &tvd->queued);
+	spin_unlock_irqrestore(&tvd->qlock, flags);
+}
+
+static void tvd_return_buffers(struct sun4i_tvd *tvd, enum vb2_buffer_state state)
+{
+	struct tvd_buffer *buf, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&tvd->qlock, flags);
+	if (tvd->active)
+		list_add_tail(&tvd->active->list, &tvd->queued);
+	if (tvd->pending)
+		list_add_tail(&tvd->pending->list, &tvd->queued);
+	tvd->active = NULL;
+	tvd->pending = NULL;
+	list_for_each_entry_safe(buf, tmp, &tvd->queued, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&tvd->qlock, flags);
+}
+
+static int tvd_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct sun4i_tvd *tvd = vb2_get_drv_priv(q);
+	unsigned long flags;
+	u32 cfg;
+
+	if (tvd->comb->val) {
+		tvd->comb_cpu = dma_alloc_coherent(tvd->dev, TVD_3D_BUF_SIZE,
+						   &tvd->comb_dma, GFP_KERNEL);
+		if (!tvd->comb_cpu) {
+			tvd_return_buffers(tvd, VB2_BUF_STATE_QUEUED);
+			return -ENOMEM;
+		}
+		/* the vendor's BSP_TVD_3D_COMB_Filter() sequence */
+		tvd_write(tvd, TVD_3D_START, tvd->comb_dma);
+		tvd_write(tvd, TVD_3D_END, tvd->comb_dma + TVD_3D_BUF_SIZE);
+		tvd_write(tvd, TVD_3D_SIZE, TVD_3D_BUF_SIZE);
+		tvd_write(tvd, TVD_3D_LATCH, TVD_3D_LATCH_ARM);
+		tvd_update(tvd, TVD_MODE, TVD_MODE_COMB_2D, 0);
+		tvd_update(tvd, TVD_EN, TVD_EN_COMB_3D, TVD_EN_COMB_3D);
+	}
+	v4l2_ctrl_grab(tvd->comb, true);
+
+	tvd_write(tvd, TVD_DMA_SIZE, (tvd->fmt.height / 2) << 16 | tvd->fmt.width);
+	tvd_write(tvd, TVD_DMA_STRIDE, tvd->fmt.bytesperline);
+	cfg = TVD_DMA_CFG_SIZE_VALID;
+	if (tvd->fmt.pixelformat == V4L2_PIX_FMT_NV16)
+		cfg |= TVD_DMA_CFG_YUV422;
+	tvd_write(tvd, TVD_DMA_CFG, cfg);
+
+	spin_lock_irqsave(&tvd->qlock, flags);
+	tvd->sequence = 0;
+	tvd->active = NULL;
+	tvd->pending = tvd_next_buffer(tvd);
+	tvd_program_buffer(tvd, tvd->pending);
+	spin_unlock_irqrestore(&tvd->qlock, flags);
+
+	tvd_write(tvd, TVD_IRQ_STATUS, ~0);
+	tvd_write(tvd, TVD_IRQ_EN, TVD_IRQ_FRAME_DONE);
+	tvd_update(tvd, TVD_DMA_CFG, TVD_DMA_CFG_EN, TVD_DMA_CFG_EN);
+	return 0;
+}
+
+static void tvd_stop_streaming(struct vb2_queue *q)
+{
+	struct sun4i_tvd *tvd = vb2_get_drv_priv(q);
+
+	tvd_write(tvd, TVD_IRQ_EN, 0);
+	tvd_update(tvd, TVD_DMA_CFG, TVD_DMA_CFG_EN, 0);
+	/* back to the 2D comb, which needs no memory */
+	tvd_update(tvd, TVD_EN, TVD_EN_COMB_3D, 0);
+	tvd_update(tvd, TVD_MODE, TVD_MODE_COMB_2D, TVD_MODE_COMB_2D);
+	tvd_write(tvd, TVD_IRQ_STATUS, ~0);
+	synchronize_irq(tvd->irq);
+	/* let a transfer in flight (capture or comb field memory) drain */
+	msleep(50);
+
+	tvd_return_buffers(tvd, VB2_BUF_STATE_ERROR);
+	if (tvd->comb_cpu) {
+		dma_free_coherent(tvd->dev, TVD_3D_BUF_SIZE, tvd->comb_cpu,
+				  tvd->comb_dma);
+		tvd->comb_cpu = NULL;
+	}
+	v4l2_ctrl_grab(tvd->comb, false);
+}
+
+static const struct vb2_ops tvd_vb2_ops = {
+	.queue_setup = tvd_queue_setup,
+	.buf_prepare = tvd_buf_prepare,
+	.buf_queue = tvd_buf_queue,
+	.start_streaming = tvd_start_streaming,
+	.stop_streaming = tvd_stop_streaming,
+};
+
+/* ---- controls --------------------------------------------------------- */
+
+static int tvd_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sun4i_tvd *tvd = container_of(ctrl->handler, struct sun4i_tvd, ctrls);
+
+	/* applied by tvd_power_on() when the device is opened */
+	if (!tvd->users)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_CONTRAST:
+		tvd_update(tvd, TVD_LUMA, GENMASK(7, 0), ctrl->val);
+		break;
+	case V4L2_CID_BRIGHTNESS:
+		tvd_update(tvd, TVD_LUMA, GENMASK(15, 8), ctrl->val << 8);
+		break;
+	case V4L2_CID_SHARPNESS:
+		tvd_update(tvd, TVD_LUMA, GENMASK(23, 16), ctrl->val << 16);
+		break;
+	case V4L2_CID_SATURATION:
+		tvd_update(tvd, TVD_CHROMA, GENMASK(7, 0), ctrl->val);
+		break;
+	case V4L2_CID_HUE:
+		tvd_update(tvd, TVD_CHROMA, GENMASK(15, 8), (u8)ctrl->val << 8);
+		break;
+	case V4L2_CID_SUN4I_TVD_CHROMA_ENH:
+		/* 0 = off, 1..4 = strength mild..high */
+		tvd_update(tvd, TVD_CHROMA, TVD_CHROMA_ENH_EN | TVD_CHROMA_ENH_STRENGTH,
+			   ctrl->val ? TVD_CHROMA_ENH_EN |
+				       FIELD_PREP(TVD_CHROMA_ENH_STRENGTH, ctrl->val - 1) :
+				       FIELD_PREP(TVD_CHROMA_ENH_STRENGTH, 3));
+		break;
+	case V4L2_CID_SUN4I_TVD_CHROMA_GAIN:
+		tvd_update(tvd, TVD_CHROMA_AGC, TVD_CHROMA_GAIN,
+			   FIELD_PREP(TVD_CHROMA_GAIN, ctrl->val));
+		break;
+	case V4L2_CID_SUN4I_TVD_BURST_START:
+		tvd_update(tvd, TVD_BURST_GATE, TVD_BURST_GATE_START,
+			   FIELD_PREP(TVD_BURST_GATE_START, ctrl->val));
+		break;
+	case V4L2_CID_SUN4I_TVD_BURST_END:
+		tvd_update(tvd, TVD_BURST_GATE, TVD_BURST_GATE_END,
+			   FIELD_PREP(TVD_BURST_GATE_END, ctrl->val));
+		break;
+	case V4L2_CID_SUN4I_TVD_BLUE_SCREEN:
+		tvd_update(tvd, TVD_BLUE, TVD_BLUE_MODE,
+			   FIELD_PREP(TVD_BLUE_MODE, ctrl->val));
+		break;
+	case V4L2_CID_SUN4I_TVD_COMB_3D:
+		/* takes effect at the next STREAMON (grabbed while streaming) */
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops tvd_ctrl_ops = {
+	.s_ctrl = tvd_s_ctrl,
+};
