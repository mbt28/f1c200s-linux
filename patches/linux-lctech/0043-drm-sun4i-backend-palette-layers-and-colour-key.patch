diff --git a/drivers/gpu/drm/sun4i/sun4i_backend.h b/drivers/gpu/drm/sun4i/sun4i_backend.h
--- a/drivers/gpu/drm/sun4i/sun4i_backend.h
+++ b/drivers/gpu/drm/sun4i/sun4i_backend.h
@@ -63,9 +63,16 @@
 #define SUN4I_BACKEND_CKMAX_REG			0x880
 #define SUN4I_BACKEND_CKMIN_REG			0x884
 #define SUN4I_BACKEND_CKCFG_REG			0x888
+/* per colour channel: 10 matches inside [min, max], 11 outside */
+#define SUN4I_BACKEND_CKCFG_INSIDE			0x2a
+#define SUN4I_BACKEND_CKCFG_OUTSIDE			0x3f
 #define SUN4I_BACKEND_ATTCTL_REG0(l)		(0x890 + (0x4 * (l)))
 #define SUN4I_BACKEND_ATTCTL_REG0_LAY_GLBALPHA_MASK	GENMASK(31, 24)
 #define SUN4I_BACKEND_ATTCTL_REG0_LAY_GLBALPHA(x)		((x) << 24)
+#define SUN4I_BACKEND_ATTCTL_REG0_LAY_WORKMOD_MASK	GENMASK(23, 22)
+#define SUN4I_BACKEND_ATTCTL_REG0_LAY_WORKMOD_PALETTE	(1 << 22)
+#define SUN4I_BACKEND_ATTCTL_REG0_LAY_CKMOD_MASK	GENMASK(19, 18)
+#define SUN4I_BACKEND_ATTCTL_REG0_LAY_CKMOD_ON		(1 << 18)
 #define SUN4I_BACKEND_ATTCTL_REG0_LAY_PIPESEL_MASK	BIT(15)
 #define SUN4I_BACKEND_ATTCTL_REG0_LAY_PIPESEL(x)		((x) << 15)
 #define SUN4I_BACKEND_ATTCTL_REG0_LAY_PRISEL_MASK	GENMASK(11, 10)
@@ -78,6 +85,9 @@
 #define SUN4I_BACKEND_ATTCTL_REG1_LAY_HSCAFCT		GENMASK(15, 14)
 #define SUN4I_BACKEND_ATTCTL_REG1_LAY_WSCAFCT		GENMASK(13, 12)
 #define SUN4I_BACKEND_ATTCTL_REG1_LAY_FBFMT		GENMASK(11, 8)
+#define SUN4I_BACKEND_ATTCTL_REG1_LAY_FBPS		GENMASK(1, 0)
+/* 1, 2 and 4 bpp: the first pixel in the high bits of each byte */
+#define SUN4I_BACKEND_LAY_FBPS_MSB_FIRST_IN_BYTE		1
 #define SUN4I_BACKEND_LAY_FBFMT_1BPP				(0 << 8)
 #define SUN4I_BACKEND_LAY_FBFMT_2BPP				(1 << 8)
 #define SUN4I_BACKEND_LAY_FBFMT_4BPP				(2 << 8)
@@ -213,6 +223,21 @@
 	u32			hwc_pattern_off;
 	u32			hwc_pattern_size;
 	u32			hwc_palette_off;
+
+	/*
+	 * The 256-entry ARGB palette for the C1/C2/C4/C8 layers (0 when not
+	 * known: then there are no palette formats), and the palette it now
+	 * holds. One palette RAM serves all the layers.
+	 */
+	u32			palette_off;
+	struct drm_property_blob	*palette;
+
+	/* the 4444 formats are reserved here (suniv) */
+	bool			no_4444;
+
+	/* plane properties: the colour key and the palette */
+	struct drm_property	*color_key_prop;
+	struct drm_property	*palette_prop;
 };
 
 static inline struct sun4i_backend *
@@ -224,6 +249,24 @@
 void sun4i_backend_layer_enable(struct sun4i_backend *backend,
 				int layer, bool enable);
 bool sun4i_backend_format_is_supported(uint32_t fmt, uint64_t modifier);
+bool sun4i_backend_format_is_palette(uint32_t fmt);
+void sun4i_backend_update_layer_color_key(struct sun4i_backend *backend,
+					  int layer, struct drm_plane *plane);
+void sun4i_backend_update_layer_palette(struct sun4i_backend *backend,
+					struct drm_plane *plane);
+
+/*
+ * COLOR_KEY plane property: bit 63 turns it on, bit 62 makes it match the
+ * colours OUTSIDE the range; bits 23:0 are the lowest RGB888 colour of the
+ * range and bits 55:32 the highest. One layer at a time can have it.
+ */
+#define SUN4I_COLOR_KEY_ENABLE			BIT_ULL(63)
+#define SUN4I_COLOR_KEY_OUTSIDE			BIT_ULL(62)
+#define SUN4I_COLOR_KEY_MIN(k)			((u32)(k) & 0xffffff)
+#define SUN4I_COLOR_KEY_MAX(k)			((u32)((k) >> 32) & 0xffffff)
+
+/* a palette has 1 to 256 ARGB8888 entries (u32 each) */
+#define SUN4I_BACKEND_PALETTE_SIZE		256
 int sun4i_backend_update_layer_coord(struct sun4i_backend *backend,
 				     int layer, struct drm_plane *plane);
 int sun4i_backend_update_layer_formats(struct sun4i_backend *backend,
