+static int sun4i_layer_atomic_set_property(struct drm_plane *plane,
+					   struct drm_plane_state *state,
+					   struct drm_property *property,
+					   uint64_t val)
+{
+	struct sun4i_layer_state *s_state = state_to_sun4i_layer_state(state);
+	struct sun4i_layer *layer = plane_to_sun4i_layer(plane);
+	struct sun4i_backend *backend = layer->backend;
+	bool replaced;
+	int ret;
+
+	if (property == backend->color_key_prop) {
+		s_state->color_key = val;
+		return 0;
+	}
+
+	if (property == backend->palette_prop) {
+		ret = drm_property_replace_blob_from_id(plane->dev,
+							&s_state->palette,
+							val, -1, sizeof(u32),
+							&replaced);
+		if (ret)
+			return ret;
+		if (s_state->palette &&
+		    s_state->palette->length > SUN4I_BACKEND_PALETTE_SIZE * sizeof(u32))
+			return -EINVAL;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sun4i_layer_atomic_get_property(struct drm_plane *plane,
+					   const struct drm_plane_state *state,
+					   struct drm_property *property,
+					   uint64_t *val)
+{
+	const struct sun4i_layer_state *s_state =
+		container_of(state, struct sun4i_layer_state, state);
+	struct sun4i_layer *layer = plane_to_sun4i_layer(plane);
+	struct sun4i_backend *backend = layer->backend;
+
+	if (property == backend->color_key_prop) {
+		*val = s_state->color_key;
+		return 0;
+	}
+
+	if (property == backend->palette_prop) {
+		*val = s_state->palette ? s_state->palette->base.id : 0;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
 static bool sun4i_layer_format_mod_supported(struct drm_plane *plane,
 					     uint32_t format, uint64_t modifier)
 {
 	struct sun4i_layer *layer = plane_to_sun4i_layer(plane);
 
