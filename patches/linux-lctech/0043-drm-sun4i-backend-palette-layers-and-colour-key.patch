+/*
+ * The colour key: the range and its rule are the backend's, one for all
+ * the layers; a layer takes part when its COLOR_KEY property is on. What a
+ * match does is the hardware's: "the layer color key match another
+ * channel pixel data in Alpha Blender1" (F1C200s User Manual 5.3.5.23),
+ * between the two pipes.
+ */
+void sun4i_backend_update_layer_color_key(struct sun4i_backend *backend,
+					  int layer, struct drm_plane *plane)
+{
+	struct sun4i_layer_state *s_state = state_to_sun4i_layer_state(plane->state);
+	u64 key = s_state->color_key;
+
+	if (!(key & SUN4I_COLOR_KEY_ENABLE)) {
+		regmap_update_bits(backend->engine.regs,
+				   SUN4I_BACKEND_ATTCTL_REG0(layer),
+				   SUN4I_BACKEND_ATTCTL_REG0_LAY_CKMOD_MASK, 0);
+		return;
+	}
+
+	regmap_write(backend->engine.regs, SUN4I_BACKEND_CKMIN_REG,
+		     SUN4I_COLOR_KEY_MIN(key));
+	regmap_write(backend->engine.regs, SUN4I_BACKEND_CKMAX_REG,
+		     SUN4I_COLOR_KEY_MAX(key));
+	regmap_write(backend->engine.regs, SUN4I_BACKEND_CKCFG_REG,
+		     key & SUN4I_COLOR_KEY_OUTSIDE ?
+		     SUN4I_BACKEND_CKCFG_OUTSIDE : SUN4I_BACKEND_CKCFG_INSIDE);
+	regmap_update_bits(backend->engine.regs,
+			   SUN4I_BACKEND_ATTCTL_REG0(layer),
+			   SUN4I_BACKEND_ATTCTL_REG0_LAY_CKMOD_MASK,
+			   SUN4I_BACKEND_ATTCTL_REG0_LAY_CKMOD_ON);
+}
+
+/*
+ * Load the plane's palette into the palette RAM, unless it holds it
+ * already. The RAM is not double-buffered: a new palette shows at once.
+ */
+void sun4i_backend_update_layer_palette(struct sun4i_backend *backend,
+					struct drm_plane *plane)
+{
+	struct sun4i_layer_state *s_state = state_to_sun4i_layer_state(plane->state);
+	struct drm_property_blob *blob = s_state->palette;
+	const u32 *entries;
+	unsigned int i, n;
+
+	if (!blob || !backend->palette_off || blob == backend->palette)
+		return;
+
+	entries = blob->data;
+	n = blob->length / sizeof(u32);
+	for (i = 0; i < SUN4I_BACKEND_PALETTE_SIZE; i++)
+		regmap_write(backend->engine.regs, backend->palette_off + 4 * i,
+			     i < n ? entries[i] : 0);
+
+	drm_property_blob_put(backend->palette);
+	backend->palette = drm_property_blob_get(blob);
+}
+
 void sun4i_backend_cleanup_layer(struct sun4i_backend *backend,
 				 int layer)
 {
@@ -485,6 +603,8 @@
