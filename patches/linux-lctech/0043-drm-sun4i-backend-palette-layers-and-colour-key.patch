+	if (backend->no_4444 || backend->palette_off) {
+		static const uint32_t palette_formats[] = {
+			DRM_FORMAT_C1, DRM_FORMAT_C2, DRM_FORMAT_C4, DRM_FORMAT_C8,
+		};
+		uint32_t *list;
+		unsigned int i, n = 0;
+
+		list = devm_kcalloc(drm->dev, formats_len + ARRAY_SIZE(palette_formats),
+				    sizeof(*list), GFP_KERNEL);
+		if (!list)
+			return ERR_PTR(-ENOMEM);
+
+		for (i = 0; i < formats_len; i++) {
+			if (backend->no_4444 &&
+			    (formats[i] == DRM_FORMAT_ARGB4444 ||
+			     formats[i] == DRM_FORMAT_RGBA4444))
+				continue;
+			list[n++] = formats[i];
+		}
+		if (backend->palette_off)
+			for (i = 0; i < ARRAY_SIZE(palette_formats); i++)
+				list[n++] = palette_formats[i];
+
+		formats = list;
+		formats_len = n;
+	}
+
 	/* possible crtcs are set later */
 	ret = drm_universal_plane_init(drm, &layer->plane, 0,
 				       &sun4i_backend_layer_funcs,
@@ -243,6 +343,25 @@
 	if (ret)
 		dev_warn(drm->dev, "Couldn't add the color properties\n");
 
+	/* the colour key, and the palette of the C1/C2/C4/C8 formats */
+	if (!backend->color_key_prop)
+		backend->color_key_prop = drm_property_create_range(drm, 0,
+								    "COLOR_KEY",
+								    0, U64_MAX);
+	if (backend->color_key_prop)
+		drm_object_attach_property(&layer->plane.base,
+					   backend->color_key_prop, 0);
+
+	if (backend->palette_off) {
+		if (!backend->palette_prop)
+			backend->palette_prop = drm_property_create(drm,
+								    DRM_MODE_PROP_BLOB,
+								    "PALETTE", 0);
+		if (backend->palette_prop)
+			drm_object_attach_property(&layer->plane.base,
+						   backend->palette_prop, 0);
+	}
+
 	return layer;
 }
 
