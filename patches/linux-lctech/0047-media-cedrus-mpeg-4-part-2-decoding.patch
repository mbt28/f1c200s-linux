+			.min	= 0,
+			.max	= 0xff,
+			.step	= 1,
+			.def	= 0,
+			.dims	= { sizeof(struct v4l2_ctrl_mpeg4_vop) },
+		},
+		.capabilities	= CEDRUS_CAPABILITY_MPEG4_DEC,
+	},
+	{
 		.cfg = {
 			.id = V4L2_CID_STATELESS_HEVC_DECODE_PARAMS,
 		},
@@ -653,6 +667,7 @@
 
 static const struct cedrus_variant suniv_f1c100s_cedrus_variant = {
 	.capabilities	= CEDRUS_CAPABILITY_MPEG2_DEC |
+			  CEDRUS_CAPABILITY_MPEG4_DEC |
 			  CEDRUS_CAPABILITY_JPEG_DEC |
 			  CEDRUS_CAPABILITY_H264_DEC,
 	.quirks		= CEDRUS_QUIRK_EXTERNAL_PRED_BUFFERS |
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -49,6 +49,11 @@
 			V4L2_CID_STATELESS_MPEG2_QUANTISATION);
 		break;
 
+	case V4L2_PIX_FMT_MPEG4_VOP:
+		run.mpeg4.vop = cedrus_find_control_data(ctx,
+			V4L2_CID_STATELESS_MPEG4_VOP);
