+		struct cedrus_mpeg4_run	mpeg4;
 	};
 };
 
@@ -163,6 +169,16 @@
 		struct {
 			unsigned int	subsampling;
 		} jpeg;
+		struct {
+			void		*mbh_buf;
+			dma_addr_t	mbh_buf_dma;
+			size_t		mbh_buf_size;
+			void		*dcac_buf;
+			dma_addr_t	dcac_buf_dma;
+			size_t		dcac_buf_size;
+			void		*ncf_buf;
+			dma_addr_t	ncf_buf_dma;
+		} mpeg4;
 	} codec;
 };
 
@@ -221,6 +237,7 @@
 extern struct cedrus_dec_ops cedrus_dec_ops_h265;
 extern struct cedrus_dec_ops cedrus_dec_ops_vp8;
 extern struct cedrus_dec_ops cedrus_dec_ops_jpeg;
+extern struct cedrus_dec_ops cedrus_dec_ops_mpeg4;
 
 static inline void cedrus_write(struct cedrus_dev *dev, u32 reg, u32 val)
 {
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -52,6 +52,7 @@
 	switch (ctx->src_fmt.pixelformat) {
 	/* MPEG2 and JPEG both use the same decoding mode bit. */
 	case V4L2_PIX_FMT_MPEG2_SLICE:
+	case V4L2_PIX_FMT_MPEG4_VOP:
 	case V4L2_PIX_FMT_JPEG:
 		reg |= VE_MODE_DEC_MPEG;
 		break;
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c b/drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus VPU driver: MPEG-4 Part 2 (Simple and Advanced Simple Profile).
+ *
+ * Not upstream (f1c200s-linux). The video engine's MPEG engine decodes a
+ * VOP from its first macroblock once the VOP header is in VOPHDR; the
+ * register sequence is libvdpau-sunxi's (mpeg4.c), which was worked out
+ * from Allwinner's CedarX. Userspace parses the headers and hands them in
+ * V4L2_CID_STATELESS_MPEG4_VOP (struct v4l2_ctrl_mpeg4_vop), as for the
+ * other stateless codecs.
+ *
+ * As libvdpau-sunxi, this decodes VOPs without resync markers only (the
+ * VOL's resync_marker_disable set), and neither H.263's short video header
+ * nor Sorenson Spark: how the engine takes those is not known.
+ */
+
+#include <linux/dma-mapping.h>
+
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+#define CEDRUS_MPEG4_NCF_BUF_SIZE	SZ_4K
+
+static enum cedrus_irq_status cedrus_mpeg4_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg;
+
+	reg = cedrus_read(dev, VE_DEC_MPEG_STATUS);
+	reg &= VE_DEC_MPEG_STATUS_CHECK_MASK;
+
+	if (!reg)
+		return CEDRUS_IRQ_NONE;
+
+	if (reg & VE_DEC_MPEG_STATUS_CHECK_ERROR ||
+	    !(reg & VE_DEC_MPEG_STATUS_SUCCESS))
+		return CEDRUS_IRQ_ERROR;
+
+	return CEDRUS_IRQ_OK;
+}
+
+static void cedrus_mpeg4_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_DEC_MPEG_STATUS, VE_DEC_MPEG_STATUS_CHECK_MASK);
+}
+
+static void cedrus_mpeg4_irq_disable(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, VE_DEC_MPEG_CTRL);
+
+	reg &= ~VE_DEC_MPEG_CTRL_IRQ_MASK;
+
+	cedrus_write(dev, VE_DEC_MPEG_CTRL, reg);
+}
+
+static unsigned int cedrus_mpeg4_mbs(unsigned int pixels)
+{
+	return DIV_ROUND_UP(pixels, 16);
+}
+
+static int cedrus_mpeg4_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	const struct v4l2_ctrl_mpeg4_vop *vop = run->mpeg4.vop;
+	struct cedrus_dev *dev = ctx->dev;
+	unsigned int width = cedrus_mpeg4_mbs(ctx->src_fmt.width);
+	unsigned int height = cedrus_mpeg4_mbs(ctx->src_fmt.height);
+	unsigned int size = vb2_get_plane_payload(&run->src->vb2_buf, 0);
+	dma_addr_t src_buf_addr, dst_luma_addr, dst_chroma_addr;
+	bool b_vop = vop->vop_coding_type == V4L2_MPEG4_VOP_TYPE_B;
+	bool i_vop = vop->vop_coding_type == V4L2_MPEG4_VOP_TYPE_I;
+	struct vb2_queue *vq;
+	unsigned int i;
+	u32 reg;
+
+	if (!(vop->flags & V4L2_MPEG4_VOP_FLAG_RESYNC_MARKER_DISABLE)) {
+		v4l2_err(&dev->v4l2_dev,
+			 "MPEG-4 VOPs with resync markers are not supported\n");
+		return -EINVAL;
+	}
+
+	if (vop->vop_coding_type == V4L2_MPEG4_VOP_TYPE_S) {
+		v4l2_err(&dev->v4l2_dev, "MPEG-4 S(GMC)-VOPs are not supported\n");
+		return -EINVAL;
+	}
+
+	if (vop->data_bit_offset >= size * 8)
+		return -EINVAL;
+
+	cedrus_engine_enable(ctx);
+
+	/* MPEG quantisation: its matrices, as MPEG-2 loads them */
+	if (vop->flags & V4L2_MPEG4_VOP_FLAG_QUANT_TYPE) {
+		for (i = 0; i < 64; i++)
+			cedrus_write(dev, VE_DEC_MPEG_IQMINPUT,
+				     VE_DEC_MPEG_IQMINPUT_WEIGHT(i, vop->intra_quant_matrix[i]) |
+				     VE_DEC_MPEG_IQMINPUT_FLAG_INTRA);
+		for (i = 0; i < 64; i++)
+			cedrus_write(dev, VE_DEC_MPEG_IQMINPUT,
+				     VE_DEC_MPEG_IQMINPUT_WEIGHT(i, vop->non_intra_quant_matrix[i]) |
+				     VE_DEC_MPEG_IQMINPUT_FLAG_NON_INTRA);
+	}
+
+	/* Work buffers: macroblock headers, DC/AC prediction, and "NCF". */
+	cedrus_write(dev, VE_DEC_MPEG_MBH_ADDR, ctx->codec.mpeg4.mbh_buf_dma);
+	cedrus_write(dev, VE_DEC_MPEG_DCAC_ADDR, ctx->codec.mpeg4.dcac_buf_dma);
+	cedrus_write(dev, VE_DEC_MPEG_NCF_ADDR, ctx->codec.mpeg4.ncf_buf_dma);
+
+	/* Destination, also through the rotate/scale-down output (off). */
+	dst_luma_addr = cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 0);
+	dst_chroma_addr = cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 1);
+	cedrus_write(dev, VE_DEC_MPEG_REC_LUMA, dst_luma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_REC_CHROMA, dst_chroma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_LUMA, dst_luma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_CHROMA, dst_chroma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_SD_ROT_DBLK_CTL, 0x40620000);
+
+	/* The VOP header. */
+	reg = VE_DEC_MPEG_VOPHDR_CODING_TYPE(vop->vop_coding_type);
+	if (b_vop)
+		reg |= VE_DEC_MPEG_VOPHDR_B_VOP;
+	reg |= VE_DEC_MPEG_VOPHDR_QUANT_TYPE(vop->flags & V4L2_MPEG4_VOP_FLAG_QUANT_TYPE);
+	reg |= VE_DEC_MPEG_VOPHDR_QUARTER_SAMPLE(vop->flags & V4L2_MPEG4_VOP_FLAG_QUARTER_SAMPLE);
+	reg |= VE_DEC_MPEG_VOPHDR_RESYNC_MARKER_DISABLE(1);
+	reg |= VE_DEC_MPEG_VOPHDR_ROUNDING_TYPE(vop->flags & V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE);
+	reg |= VE_DEC_MPEG_VOPHDR_INTRA_DC_VLC_THR(vop->intra_dc_vlc_thr);
+	reg |= VE_DEC_MPEG_VOPHDR_TOP_FIELD_FIRST(vop->flags & V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST);
+	reg |= VE_DEC_MPEG_VOPHDR_ALT_VERTICAL_SCAN(vop->flags & V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN);
+	if (!i_vop)
+		reg |= VE_DEC_MPEG_VOPHDR_FCODE_FORWARD(vop->vop_fcode_forward);
+	if (b_vop)
+		reg |= VE_DEC_MPEG_VOPHDR_FCODE_BACKWARD(vop->vop_fcode_backward);
+	cedrus_write(dev, VE_DEC_MPEG_VOPHDR, reg);
+
+	/* Sizes: in macroblocks (plus the width rounded up to even), and pixels. */
+	cedrus_write(dev, VE_DEC_MPEG_PICCODEDSIZE,
+		     (((width + 1) & ~1) << 16) | (width << 8) | height);
+	cedrus_write(dev, VE_DEC_MPEG_PICBOUNDSIZE,
+		     ((width * 16) << 16) | (height * 16));
+
+	cedrus_write(dev, VE_DEC_MPEG_MBADDR, 0);
+
+	/* Interrupts and the engine's controls, as libvdpau-sunxi sets them. */
+	reg = 0x80084118 | VE_DEC_MPEG_CTRL_MC_NO_WRITEBACK;
+	if (vop->vop_coding_type == V4L2_MPEG4_VOP_TYPE_P)
+		reg |= BIT(12);
+	cedrus_write(dev, VE_DEC_MPEG_CTRL, reg);
+
+	cedrus_write(dev, VE_DEC_MPEG_QP_INPUT, vop->vop_quant);
+
+	/* References. */
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE);
+	if (!i_vop)
+		cedrus_write_ref_buf_addr(ctx, vq, vop->forward_ref_ts,
+					  VE_DEC_MPEG_FWD_REF_LUMA_ADDR,
+					  VE_DEC_MPEG_FWD_REF_CHROMA_ADDR);
+	if (b_vop) {
+		cedrus_write_ref_buf_addr(ctx, vq, vop->backward_ref_ts,
+					  VE_DEC_MPEG_BWD_REF_LUMA_ADDR,
+					  VE_DEC_MPEG_BWD_REF_CHROMA_ADDR);
+		cedrus_write(dev, VE_DEC_MPEG_TRBTRD_FRAME,
+			     (vop->trb[0] << 16) | vop->trd[0]);
+		cedrus_write(dev, VE_DEC_MPEG_TRBTRD_FIELD,
+			     (vop->trb[1] << 16) | vop->trd[1]);
+	}
+
+	cedrus_write(dev, VE_DEC_MPEG_STATUS, 0xffffffff);
+
+	/* The macroblock data: past the VOP header. */
+	cedrus_write(dev, VE_DEC_MPEG_VLD_OFFSET, vop->data_bit_offset);
+	cedrus_write(dev, VE_DEC_MPEG_VLD_LEN, size * 8 - vop->data_bit_offset);
+
+	src_buf_addr = vb2_dma_contig_plane_dma_addr(&run->src->vb2_buf, 0);
+	reg = VE_DEC_MPEG_VLD_ADDR_BASE(src_buf_addr);
+	reg |= VE_DEC_MPEG_VLD_ADDR_VALID_PIC_DATA;
+	reg |= VE_DEC_MPEG_VLD_ADDR_LAST_PIC_DATA;
+	reg |= VE_DEC_MPEG_VLD_ADDR_FIRST_PIC_DATA;
+	cedrus_write(dev, VE_DEC_MPEG_VLD_ADDR, reg);
+	cedrus_write(dev, VE_DEC_MPEG_VLD_END_ADDR, src_buf_addr + size);
+
+	return 0;
+}
+
+static void cedrus_mpeg4_trigger(struct cedrus_ctx *ctx)
+{
+	unsigned int mbs = cedrus_mpeg4_mbs(ctx->src_fmt.width) *
+			   cedrus_mpeg4_mbs(ctx->src_fmt.height);
+
+	/* MPEG-4, hardware macroblock decoding, over all the macroblocks */
+	cedrus_write(ctx->dev, VE_DEC_MPEG_TRIGGER,
+		     VE_DEC_MPEG_TRIGGER_MB_BOUNDARY | VE_DEC_MPEG_TRIGGER_MPEG4 |
+		     (mbs << 8) | VE_DEC_MPEG_TRIGGER_HW_MB);
+}
+
+static int cedrus_mpeg4_start(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	unsigned int width = cedrus_mpeg4_mbs(ctx->src_fmt.width);
+	unsigned int height = cedrus_mpeg4_mbs(ctx->src_fmt.height);
+
+	/* sizes from libvdpau-sunxi */
+	ctx->codec.mpeg4.mbh_buf_size = height * 2048;
+	ctx->codec.mpeg4.mbh_buf = dma_alloc_attrs(dev->dev,
+						   ctx->codec.mpeg4.mbh_buf_size,
+						   &ctx->codec.mpeg4.mbh_buf_dma,
+						   GFP_KERNEL,
+						   DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!ctx->codec.mpeg4.mbh_buf)
+		return -ENOMEM;
+
+	ctx->codec.mpeg4.dcac_buf_size = width * height * 2;
+	ctx->codec.mpeg4.dcac_buf = dma_alloc_attrs(dev->dev,
+						    ctx->codec.mpeg4.dcac_buf_size,
+						    &ctx->codec.mpeg4.dcac_buf_dma,
+						    GFP_KERNEL,
+						    DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!ctx->codec.mpeg4.dcac_buf)
+		goto err_mbh;
+
+	ctx->codec.mpeg4.ncf_buf = dma_alloc_attrs(dev->dev,
+						   CEDRUS_MPEG4_NCF_BUF_SIZE,
+						   &ctx->codec.mpeg4.ncf_buf_dma,
+						   GFP_KERNEL,
+						   DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!ctx->codec.mpeg4.ncf_buf)
+		goto err_dcac;
+
+	return 0;
+
+err_dcac:
+	dma_free_attrs(dev->dev, ctx->codec.mpeg4.dcac_buf_size,
+		       ctx->codec.mpeg4.dcac_buf, ctx->codec.mpeg4.dcac_buf_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+err_mbh:
+	dma_free_attrs(dev->dev, ctx->codec.mpeg4.mbh_buf_size,
+		       ctx->codec.mpeg4.mbh_buf, ctx->codec.mpeg4.mbh_buf_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+	return -ENOMEM;
+}
+
+static void cedrus_mpeg4_stop(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	dma_free_attrs(dev->dev, CEDRUS_MPEG4_NCF_BUF_SIZE,
+		       ctx->codec.mpeg4.ncf_buf, ctx->codec.mpeg4.ncf_buf_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+	dma_free_attrs(dev->dev, ctx->codec.mpeg4.dcac_buf_size,
+		       ctx->codec.mpeg4.dcac_buf, ctx->codec.mpeg4.dcac_buf_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+	dma_free_attrs(dev->dev, ctx->codec.mpeg4.mbh_buf_size,
+		       ctx->codec.mpeg4.mbh_buf, ctx->codec.mpeg4.mbh_buf_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_mpeg4 = {
+	.irq_clear	= cedrus_mpeg4_irq_clear,
+	.irq_disable	= cedrus_mpeg4_irq_disable,
+	.irq_status	= cedrus_mpeg4_irq_status,
+	.setup		= cedrus_mpeg4_setup,
+	.start		= cedrus_mpeg4_start,
+	.stop		= cedrus_mpeg4_stop,
+	.trigger	= cedrus_mpeg4_trigger,
+};
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -131,6 +131,25 @@
 #define VE_DEC_MPEG_PICBOUNDSIZE_HEIGHT(h)	SHIFT_AND_MASK_BITS(h, 11, 0)
 
 #define VE_DEC_MPEG_MBADDR			(VE_ENGINE_DEC_MPEG + 0x10)
+/* MPEG-4 Part 2 (libvdpau-sunxi / libcedrus names) */
+#define VE_DEC_MPEG_VOPHDR			(VE_ENGINE_DEC_MPEG + 0x04)
+#define VE_DEC_MPEG_VOPHDR_B_VOP			BIT(28)
+#define VE_DEC_MPEG_VOPHDR_QUANT_TYPE(v)		(((v) ? 1 : 0) << 24)
+#define VE_DEC_MPEG_VOPHDR_QUARTER_SAMPLE(v)		(((v) ? 1 : 0) << 23)
+#define VE_DEC_MPEG_VOPHDR_RESYNC_MARKER_DISABLE(v)	(((v) ? 1 : 0) << 22)
+#define VE_DEC_MPEG_VOPHDR_CODING_TYPE(t)		(((t) & 0x3) << 18)
+#define VE_DEC_MPEG_VOPHDR_ROUNDING_TYPE(v)		(((v) ? 1 : 0) << 17)
+#define VE_DEC_MPEG_VOPHDR_INTRA_DC_VLC_THR(t)		(((t) & 0x7) << 8)
+#define VE_DEC_MPEG_VOPHDR_TOP_FIELD_FIRST(v)		(((v) ? 1 : 0) << 7)
