 #define V4L2_CID_STATELESS_MPEG2_QUANTISATION (V4L2_CID_CODEC_STATELESS_BASE+222)
+
+/*
+ * Not upstream (f1c200s-linux): MPEG-4 Part 2 (ISO/IEC 14496-2) Simple and
+ * Advanced Simple Profile, one VOP per OUTPUT buffer (V4L2_PIX_FMT_MPEG4_VOP),
+ * on the Allwinner video engine. The control is a U8 array the size of
+ * struct v4l2_ctrl_mpeg4_vop.
+ */
+#define V4L2_CID_STATELESS_MPEG4_VOP	(V4L2_CID_CODEC_STATELESS_BASE + 0x7f0)
+
+#define V4L2_MPEG4_VOP_TYPE_I			0
+#define V4L2_MPEG4_VOP_TYPE_P			1
+#define V4L2_MPEG4_VOP_TYPE_B			2
+#define V4L2_MPEG4_VOP_TYPE_S			3
+
+/* the VOL's flags */
+#define V4L2_MPEG4_VOP_FLAG_QUANT_TYPE			0x01	/* MPEG quantisation, the matrices below */
+#define V4L2_MPEG4_VOP_FLAG_QUARTER_SAMPLE		0x02
+#define V4L2_MPEG4_VOP_FLAG_RESYNC_MARKER_DISABLE	0x04
+#define V4L2_MPEG4_VOP_FLAG_INTERLACED			0x08
+/* the VOP's */
+#define V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE		0x10
+#define V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST		0x20
+#define V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN	0x40
+
+/**
+ * struct v4l2_ctrl_mpeg4_vop - one MPEG-4 Part 2 VOP
+ *
+ * @forward_ref_ts: timestamp of the CAPTURE buffer of the forward
+ *	reference (P and B VOPs)
+ * @backward_ref_ts: timestamp of the backward reference (B VOPs)
+ * @data_bit_offset: bits from the start of the OUTPUT buffer to the
+ *	first macroblock, past the VOP header
+ * @trb: B VOP: temporal distance to the forward reference [frame, field]
+ * @trd: B VOP: distance between the references [frame, field]
+ * @flags: V4L2_MPEG4_VOP_FLAG_*
+ * @vop_coding_type: V4L2_MPEG4_VOP_TYPE_*
+ * @vop_quant: the VOP's quantiser
+ * @intra_dc_vlc_thr: intra_dc_vlc_thr
+ * @vop_fcode_forward: vop_fcode_forward (P, B)
+ * @vop_fcode_backward: vop_fcode_backward (B)
+ * @intra_quant_matrix: with QUANT_TYPE, in zigzag scan order
+ * @non_intra_quant_matrix: with QUANT_TYPE, in zigzag scan order
+ */
+struct v4l2_ctrl_mpeg4_vop {
+	__u64	forward_ref_ts;
+	__u64	backward_ref_ts;
+	__u32	data_bit_offset;
+	__u16	trb[2];
+	__u16	trd[2];
+	__u8	flags;
+	__u8	vop_coding_type;
+	__u8	vop_quant;
+	__u8	intra_dc_vlc_thr;
+	__u8	vop_fcode_forward;
+	__u8	vop_fcode_backward;
+	__u8	reserved[2];
+	__u8	intra_quant_matrix[64];
+	__u8	non_intra_quant_matrix[64];
+};
 /**
  * struct v4l2_ctrl_mpeg2_quantisation - MPEG-2 quantisation
  *
