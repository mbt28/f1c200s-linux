From: mbt28 <btekbas@gmail.com>
Subject: [PATCH] drm/sun4i: backend: write-back as a writeback connector (suniv)

The backend can write the frame it composes -- all layers, the frontend
plane and the cursor, blended -- to memory while it still drives the LCD
(F1C200s User Manual 5.3.5.33-35: WBCTL 0x8f0, WBADD 0x8f4 and
WBLINEWIDTH 0x8f8, the last two in bits). Expose it as a DRM writeback
connector on the backend's CRTC: ARGB8888/XRGB8888 (the backend's
"ARGB") and BGRA8888/BGRX8888, the size of the mode.

A job is queued when its commit is applied (the registers are buffered,
so the backend is told to load them again) and signalled from the vblank
once the backend has started (WBCTL EN cleared) and finished (BUSY
cleared) that frame; ERR fails it with -EIO. A new optional engine op
creates the connector once the CRTC exists. Enabled for suniv only.
---
diff --git a/drivers/gpu/drm/sun4i/Makefile b/drivers/gpu/drm/sun4i/Makefile
--- a/drivers/gpu/drm/sun4i/Makefile
+++ b/drivers/gpu/drm/sun4i/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
-sun4i-backend-y			+= sun4i_backend.o sun4i_layer.o sun4i_cursor.o
+sun4i-backend-y			+= sun4i_backend.o sun4i_layer.o sun4i_cursor.o \
+				   sun4i_writeback.o
 sun4i-frontend-y		+= sun4i_frontend.o
 
 sun4i-drm-y			+= sun4i_drv.o
diff --git a/drivers/gpu/drm/sun4i/sun4i_backend.c b/drivers/gpu/drm/sun4i/sun4i_backend.c
--- a/drivers/gpu/drm/sun4i/sun4i_backend.c
+++ b/drivers/gpu/drm/sun4i/sun4i_backend.c
@@ -50,6 +50,9 @@
 
 	/* the 4444 formats (codes 12 and 13) are reserved */
 	bool no_4444;
+
+	/* the output can be written back to memory, and that is tested */
+	bool has_writeback;
 };
 
 static const u32 sunxi_rgb2yuv_coef[12] = {
@@ -769,6 +772,8 @@
 	struct sun4i_backend *backend = engine_to_sun4i_backend(engine);
 	struct sun4i_frontend *frontend = backend->frontend;
 
+	sun4i_writeback_vblank(backend);
+
 	if (!frontend)
 		return;
 
@@ -916,6 +921,18 @@
 	return ERR_PTR(-EINVAL);
 }
 
+static int sun4i_backend_writeback_init(struct sunxi_engine *engine,
+					struct drm_device *drm,
+					struct drm_crtc *crtc)
+{
+	struct sun4i_backend *backend = engine_to_sun4i_backend(engine);
+
+	if (!backend->has_writeback)
+		return 0;
+
+	return sun4i_writeback_init(backend, drm, crtc);
+}
+
 static const struct sunxi_engine_ops sun4i_backend_engine_ops = {
 	.atomic_begin			= sun4i_backend_atomic_begin,
 	.atomic_check			= sun4i_backend_atomic_check,
@@ -925,6 +942,7 @@
 	.disable_color_correction	= sun4i_backend_disable_color_correction,
 	.vblank_quirk			= sun4i_backend_vblank_quirk,
 	.mode_set			= sun4i_backend_mode_set,
+	.writeback_init			= sun4i_backend_writeback_init,
 };
 
 static const struct regmap_config sun4i_backend_regmap_config = {
@@ -1087,6 +1105,7 @@
 	backend->hwc_palette_off = quirks->hwc_palette_off;
 	backend->palette_off = quirks->palette_off;
 	backend->no_4444 = quirks->no_4444;
+	backend->has_writeback = quirks->has_writeback;
 
 	return 0;
 
@@ -1167,6 +1186,7 @@
 	.hwc_palette_off = SUNIV_BACKEND_HWCPALETTE_OFF,
 	.palette_off = SUNIV_BACKEND_PALETTE_OFF,
 	.no_4444 = true,
+	.has_writeback = true,
 };
 
 static const struct of_device_id sun4i_backend_of_table[] = {
