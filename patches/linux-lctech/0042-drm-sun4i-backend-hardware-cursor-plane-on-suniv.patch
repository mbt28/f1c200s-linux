@@ -253,8 +253,11 @@
 	struct sun4i_backend *backend = engine_to_sun4i_backend(engine);
 	int i;
 
-	/* We need to have a sentinel at the need, hence the overallocation */
-	planes = devm_kcalloc(drm->dev, SUN4I_BACKEND_NUM_LAYERS + 1,
+	/*
+	 * We need to have a sentinel at the need, hence the overallocation,
+	 * and room for the cursor plane.
+	 */
+	planes = devm_kcalloc(drm->dev, SUN4I_BACKEND_NUM_LAYERS + 2,
 			      sizeof(*planes), GFP_KERNEL);
 	if (!planes)
 		return ERR_PTR(-ENOMEM);
@@ -273,5 +276,14 @@
 		planes[i] = &layer->plane;
 	}
 
+	if (backend->hwc_pattern_off) {
+		struct drm_plane *cursor = sun4i_cursor_init(drm, backend);
+
+		if (IS_ERR(cursor))
+			dev_warn(drm->dev, "Couldn't initialize the cursor plane\n");
+		else
+			planes[i] = cursor;
+	}
+
 	return planes;
 }
