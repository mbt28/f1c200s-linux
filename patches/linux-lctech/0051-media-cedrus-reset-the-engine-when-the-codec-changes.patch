From: mbt28 <btekbas@gmail.com>
Subject: [PATCH] media: cedrus: reset the engine when the codec changes

The MPEG engine decodes MPEG-1/2, MPEG-4 and JPEG, and keeps state from
one job to the next. On the F1C200s every JPEG decoded after a single
MPEG-2 picture came out as garbage (PSNR 7 dB against 69 dB from a fresh
boot), later jobs were refused outright, and it stayed so until a reboot.

Zeroing the MPEG registers the other codecs leave behind does not clear
it (and made JPEG and MPEG-2 time out), and neither does the CCU bus
reset: after it the registers still read back what MPEG-2 wrote. The
engine's own reset at VE 0x04 does: after it the registers read zero,
the same JPEG decodes at 69/75 dB (Y/UV, as on a fresh boot) and MPEG-2
after it at 75/72 dB.

Pulse that reset in cedrus_engine_enable() whenever the job's codec is
not the previous job's. A stream of one codec never pays for it; a switch
costs 20 us.
---
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -226,6 +226,9 @@
 
 	struct reset_control	*rstc;
 
+	/* the codec of the last job, to reset the engine when it changes */
+	const struct cedrus_dec_ops	*last_codec;
+
 	unsigned int		capabilities;
 	unsigned int		quirks;
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -19,6 +19,7 @@
 #include <linux/dma-mapping.h>
 #include <linux/interrupt.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
@@ -33,9 +34,27 @@
 
 int cedrus_engine_enable(struct cedrus_ctx *ctx)
 {
+	struct cedrus_dev *dev = ctx->dev;
 	u32 reg = 0;
 
 	/*
+	 * The MPEG engine runs MPEG-1/2, MPEG-4 and JPEG and keeps state from
+	 * one job to the next that no register write undoes: on the F1C200s
+	 * every JPEG after a single MPEG-2 picture came out as garbage (PSNR
+	 * 7 dB, then refused outright) until a reboot, and neither zeroing
+	 * the MPEG registers nor the CCU reset cleared it. The engine's own
+	 * reset does. Pulse it whenever the codec changes; a stream of one
+	 * codec never pays for it.
+	 */
+	if (dev->last_codec != ctx->current_codec) {
+		cedrus_write(dev, VE_RESET, VE_RESET_DECODER);
+		udelay(10);
+		cedrus_write(dev, VE_RESET, 0);
+		udelay(10);
+		dev->last_codec = ctx->current_codec;
+	}
+
+	/*
 	 * FIXME: This is only valid on 32-bits DDR's, we should test
 	 * it on the A13/A33.
 	 *
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -35,6 +35,14 @@
 
 #define VE_MODE					0x00
 
+/*
+ * The engine's own reset (suniv, VE 0x1663): bit 0 high, then low, puts
+ * the decoder registers and its internal state back to power-on. The CCU
+ * bus reset does not; there the registers keep their values.
+ */
+#define VE_RESET				0x04
+#define VE_RESET_DECODER			BIT(0)
+
 #define VE_MODE_PIC_WIDTH_IS_4096		BIT(22)
 #define VE_MODE_PIC_WIDTH_MORE_2048		BIT(21)
 #define VE_MODE_REC_WR_MODE_2MB			(0x01 << 20)
