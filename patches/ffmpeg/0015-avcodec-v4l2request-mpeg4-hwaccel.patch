+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/*
+ * MPEG-4 Part 2 through the V4L2 Request API, on a kernel that has the
+ * stateless MPEG-4 VOP control (f1c200s-linux cedrus; not upstream). One
+ * VOP per request: the slice data starts at the byte holding the first
+ * macroblock, and data_bit_offset says where in it.
+ */
+
+#include "config.h"
+#include "config_components.h"
+
+#include "h263dec.h"
+#include "hwaccel_internal.h"
+#include "hwconfig.h"
+#include "mpeg4videodec.h"
+#include "mpegvideo.h"
+#include "mpegvideodec.h"
+#include "v4l2_request.h"
+
+typedef struct V4L2RequestControlsMPEG4 {
+    V4L2RequestPictureContext pic;
+    struct v4l2_ctrl_mpeg4_vop vop;
+} V4L2RequestControlsMPEG4;
+
+/* the bitstream's intra_dc_vlc_thr, from the decoder's threshold */
+static int mpeg4_intra_dc_vlc_thr(const Mpeg4DecContext *ctx)
+{
+    switch (ctx->intra_dc_threshold) {
+    case 99: return 0;
+    case 13: return 1;
+    case 15: return 2;
+    case 17: return 3;
+    case 19: return 4;
+    case 21: return 5;
+    case 23: return 6;
+    case 0:  return 7;
+    }
+    return 0;
+}
+
+static int v4l2_request_mpeg4_start_frame(AVCodecContext *avctx,
+                                          av_unused const AVBufferRef *buf_ref,
+                                          av_unused const uint8_t *buffer,
+                                          av_unused uint32_t size)
+{
+    Mpeg4DecContext *ctx = avctx->priv_data;
+    MPVContext *const s = &ctx->h.c;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+    struct v4l2_ctrl_mpeg4_vop *vop = &controls->vop;
+    int ret;
+
+    ret = ff_v4l2_request_start_frame(avctx, &controls->pic, s->cur_pic.ptr->f);
+    if (ret)
+        return ret;
+
+    *vop = (struct v4l2_ctrl_mpeg4_vop) {
+        .vop_coding_type    = s->pict_type - AV_PICTURE_TYPE_I,
+        .intra_dc_vlc_thr   = mpeg4_intra_dc_vlc_thr(ctx),
+        .vop_fcode_forward  = ctx->f_code,
+        .vop_fcode_backward = ctx->b_code,
+        .trb                = { s->pb_time, s->pb_field_time },
+        .trd                = { s->pp_time, s->pp_field_time },
+    };
+
+    if (ctx->mpeg_quant)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_QUANT_TYPE;
+    if (s->quarter_sample)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_QUARTER_SAMPLE;
+    if (!ctx->resync_marker)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_RESYNC_MARKER_DISABLE;
+    if (!s->progressive_sequence)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_INTERLACED;
+    if (s->no_rounding)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE;
+    if (s->top_field_first)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST;
+    if (s->alternate_scan)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN;
+
+    switch (s->pict_type) {
+    case AV_PICTURE_TYPE_B:
+        if (s->next_pic.ptr)
+            vop->backward_ref_ts =
+                ff_v4l2_request_get_capture_timestamp(s->next_pic.ptr->f);
+        // fall-through
+    case AV_PICTURE_TYPE_P:
+    case AV_PICTURE_TYPE_S:
+        if (s->last_pic.ptr)
+            vop->forward_ref_ts =
+                ff_v4l2_request_get_capture_timestamp(s->last_pic.ptr->f);
+    }
+
+    /* only MPEG quantisation uses the weighting matrices */
+    if (ctx->mpeg_quant) {
+        for (int i = 0; i < 64; i++) {
+            int n = s->idsp.idct_permutation[ff_zigzag_direct[i]];
+            vop->intra_quant_matrix[i]     = s->intra_matrix[n];
+            vop->non_intra_quant_matrix[i] = s->inter_matrix[n];
+        }
+    }
+
+    return 0;
+}
+
+static int v4l2_request_mpeg4_decode_slice(AVCodecContext *avctx,
+                                           const uint8_t *buffer, uint32_t size)
+{
+    H263DecContext *const h = avctx->priv_data;
+    V4L2RequestControlsMPEG4 *controls = h->c.cur_pic.ptr->hwaccel_picture_private;
+
+    /* the first macroblock: this many bits into what is appended now */
+    controls->vop.data_bit_offset = controls->pic.output->bytesused * 8 +
+                                    get_bits_count(&h->gb) % 8;
+    controls->vop.vop_quant = h->c.qscale;
+
+    return ff_v4l2_request_append_output(avctx, &controls->pic, buffer, size);
+}
+
+static int v4l2_request_mpeg4_end_frame(AVCodecContext *avctx)
+{
+    MPVContext *const s = avctx->priv_data;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+
+    struct v4l2_ext_control control[] = {
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOP,
+            .ptr = &controls->vop,
+            .size = sizeof(controls->vop),
+        },
+    };
+
+    return ff_v4l2_request_decode_frame(avctx, &controls->pic,
+                                        control, FF_ARRAY_ELEMS(control));
+}
+
+static int v4l2_request_mpeg4_init(AVCodecContext *avctx)
+{
+    return ff_v4l2_request_init(avctx, NULL, 0, NULL);
+}
+
+static int v4l2_request_mpeg4_frame_params(AVCodecContext *avctx,
+                                           AVBufferRef *hw_frames_ctx)
+{
+    return ff_v4l2_request_frame_params(avctx, hw_frames_ctx,
+                                        V4L2_PIX_FMT_MPEG4_VOP, 8);
+}
+
+const FFHWAccel ff_mpeg4_v4l2request_hwaccel = {
+    .p.name             = "mpeg4_v4l2request",
+    .p.type             = AVMEDIA_TYPE_VIDEO,
+    .p.id               = AV_CODEC_ID_MPEG4,
+    .p.pix_fmt          = AV_PIX_FMT_DRM_PRIME,
+    .start_frame        = v4l2_request_mpeg4_start_frame,
+    .decode_slice       = v4l2_request_mpeg4_decode_slice,
+    .end_frame          = v4l2_request_mpeg4_end_frame,
+    .flush              = ff_v4l2_request_flush,
+    .frame_priv_data_size = sizeof(V4L2RequestControlsMPEG4),
+    .init               = v4l2_request_mpeg4_init,
+    .uninit             = ff_v4l2_request_uninit,
+    .priv_data_size     = sizeof(V4L2RequestContext),
+    .frame_params       = v4l2_request_mpeg4_frame_params,
+    .caps_internal      = HWACCEL_CAP_ASYNC_SAFE,
+};
