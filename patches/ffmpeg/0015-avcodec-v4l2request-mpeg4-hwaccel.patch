From: mbt28 <btekbas@gmail.com>
Subject: [PATCH] avcodec: V4L2 Request API mpeg4 hwaccel (cedrus)

MPEG-4 Part 2 through the V4L2 Request API, on a kernel with the
stateless MPEG-4 VOP control (f1c200s-linux cedrus: V4L2_PIX_FMT_MPEG4_VOP
and V4L2_CID_STATELESS_MPEG4_VOP, not upstream). One VOP per request;
the header fields come from the mpeg4 decoder, as for VA-API, and the
slice data starts at the byte holding the first macroblock, with
data_bit_offset saying where in it. Built only when the kernel headers
define the control.
---
diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -3296,6 +3296,8 @@
 mpeg1_v4l2request_hwaccel_deps="v4l2_request mpeg2_v4l2_request"
 mpeg1_v4l2request_hwaccel_select="mpeg1video_decoder"
 mpeg2_v4l2request_hwaccel_deps="v4l2_request mpeg2_v4l2_request"
+mpeg4_v4l2request_hwaccel_deps="v4l2_request mpeg4_v4l2_request"
+mpeg4_v4l2request_hwaccel_select="mpeg4_decoder"
 mpeg2_v4l2request_hwaccel_select="mpeg2video_decoder"
 mpeg2_vaapi_hwaccel_deps="vaapi"
 mpeg2_vaapi_hwaccel_select="mpeg2video_decoder"
@@ -7387,6 +7389,7 @@
     check_cc h264_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_H264_DECODE_MODE"
     check_cc hevc_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_HEVC_SPS"
     check_cc mpeg2_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_MPEG2_SEQUENCE"
+    check_cc mpeg4_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_MPEG4_VOP"
     check_cc v4l2_m2m_hold_capture_buf linux/videodev2.h "int i = V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF"
     check_cc vp8_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_VP8_FRAME"
     check_cc vp9_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_VP9_FRAME"
diff --git a/libavcodec/h263dec.c b/libavcodec/h263dec.c
--- a/libavcodec/h263dec.c
+++ b/libavcodec/h263dec.c
@@ -59,6 +59,9 @@
 #if CONFIG_MPEG4_VDPAU_HWACCEL
     AV_PIX_FMT_VDPAU,
 #endif
+#if CONFIG_MPEG4_V4L2REQUEST_HWACCEL
+    AV_PIX_FMT_DRM_PRIME,
+#endif
 #if CONFIG_H263_VIDEOTOOLBOX_HWACCEL || CONFIG_MPEG4_VIDEOTOOLBOX_HWACCEL
     AV_PIX_FMT_VIDEOTOOLBOX,
 #endif
diff --git a/libavcodec/hwaccels.h b/libavcodec/hwaccels.h
--- a/libavcodec/hwaccels.h
+++ b/libavcodec/hwaccels.h
@@ -64,6 +64,7 @@
 extern const struct FFHWAccel ff_mpeg2_nvdec_hwaccel;
 extern const struct FFHWAccel ff_mpeg1_v4l2request_hwaccel;
 extern const struct FFHWAccel ff_mpeg2_v4l2request_hwaccel;
+extern const struct FFHWAccel ff_mpeg4_v4l2request_hwaccel;
 extern const struct FFHWAccel ff_mpeg2_vaapi_hwaccel;
 extern const struct FFHWAccel ff_mpeg2_vdpau_hwaccel;
 extern const struct FFHWAccel ff_mpeg2_videotoolbox_hwaccel;
diff --git a/libavcodec/Makefile b/libavcodec/Makefile
--- a/libavcodec/Makefile
+++ b/libavcodec/Makefile
@@ -1069,6 +1069,7 @@
 OBJS-$(CONFIG_MPEG2_QSV_HWACCEL)          += qsvdec.o
 OBJS-$(CONFIG_MPEG1_V4L2REQUEST_HWACCEL)  += v4l2_request_mpeg2.o
 OBJS-$(CONFIG_MPEG2_V4L2REQUEST_HWACCEL)  += v4l2_request_mpeg2.o
+OBJS-$(CONFIG_MPEG4_V4L2REQUEST_HWACCEL)  += v4l2_request_mpeg4.o
 OBJS-$(CONFIG_MPEG2_VAAPI_HWACCEL)        += vaapi_mpeg2.o
 OBJS-$(CONFIG_MPEG2_VDPAU_HWACCEL)        += vdpau_mpeg12.o
 OBJS-$(CONFIG_MPEG2_VIDEOTOOLBOX_HWACCEL) += videotoolbox.o
diff --git a/libavcodec/mpeg4videodec.c b/libavcodec/mpeg4videodec.c
--- a/libavcodec/mpeg4videodec.c
+++ b/libavcodec/mpeg4videodec.c
@@ -4106,6 +4106,9 @@
 #if CONFIG_MPEG4_VIDEOTOOLBOX_HWACCEL
                                HWACCEL_VIDEOTOOLBOX(mpeg4),
 #endif
+#if CONFIG_MPEG4_V4L2REQUEST_HWACCEL
+                               HWACCEL_V4L2REQUEST(mpeg4),
+#endif
                                NULL
                            },
 };
diff --git a/libavcodec/v4l2_request_mpeg4.c b/libavcodec/v4l2_request_mpeg4.c
--- a/libavcodec/v4l2_request_mpeg4.c
+++ b/libavcodec/v4l2_request_mpeg4.c
@@ -0,0 +1,180 @@
+/*
