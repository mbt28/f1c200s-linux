From b666caf56d8fcb657e760c52a0cd0bed427d4106 Mon Sep 17 00:00:00 2001
From: mbt28 <btekbas@gmail.com>
Date: Thu, 5 Nov 2026 21:24:26 +0100
Subject: [PATCH 2/2] psplash-systemd: the console's status lines under the bar

Besides the progress, psplash-systemd subscribes to systemd's JobRemoved
signal on a second connection to the private bus. Every job that ends
becomes a line like the console's: "Started X", "Reached target X",
"Mounted X", "Listening on X", "Activated swap X", "FAILED X",
"Dependency failed for X" (X the unit's Description; devices, slices
and scopes left out). The last three are sent as one MSG with '|' between
the lines (see the previous patch). Signals give every job in order, where
polling the running jobs once a second missed the short ones.

Upstream-Status: Inappropriate [LEHU's look]
---
 psplash-systemd.c | 110 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 110 insertions(+)

diff --git a/psplash-systemd.c b/psplash-systemd.c
index 840bd4e..db253d4 100644
--- a/psplash-systemd.c
+++ b/psplash-systemd.c
@@ -11,6 +11,7 @@
 #include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <fcntl.h>
 #include <unistd.h>
 #include <systemd/sd-bus.h>
@@ -23,6 +24,112 @@ typedef uint64_t usec_t;
 
 static int pipe_fd;
 
+/*
+ * The console's status lines on the splash: systemd's JobRemoved signal
+ * gives every job that ends, in order; each becomes a line like the
+ * console's ("Started X", "Reached target X", "Mounted X", "FAILED X"),
+ * and the last MSG_LINES are sent to psplash as one MSG, '|' between the
+ * lines.
+ */
+#define MSG_LINES 3
+#define MSG_COLS 60
+
+static char msg_lines[MSG_LINES][MSG_COLS + 1];
+static sd_bus *job_bus;
+
+static void msg_push(const char *verb, const char *what)
+{
+	char buffer[16 + MSG_LINES * (MSG_COLS + 1)];
+	char *c;
+	int i, len;
+
+	for (i = 0; i < MSG_LINES - 1; i++)
+		memcpy(msg_lines[i], msg_lines[i + 1], sizeof msg_lines[i]);
+	snprintf(msg_lines[MSG_LINES - 1], sizeof msg_lines[0], "%s %s",
+		 verb, what);
+	for (c = msg_lines[MSG_LINES - 1]; *c; c++)
+		if (*c == '|')
+			*c = '/';
+
+	len = snprintf(buffer, sizeof buffer, "MSG %s|%s|%s",
+		       msg_lines[0], msg_lines[1], msg_lines[2]);
+	if (len >= (int)sizeof buffer)
+		len = sizeof buffer - 1;
+	write(pipe_fd, buffer, len + 1);
+}
+
+static int on_job_removed(sd_bus_message *m, void *userdata,
+			  sd_bus_error *ret_error)
+{
+	const char *job, *unit, *result, *suffix, *verb;
+	char *path = NULL, *desc = NULL;
+	uint32_t id;
+	int done;
+
+	(void)userdata;
+	(void)ret_error;
+
+	if (sd_bus_message_read(m, "uoss", &id, &job, &unit, &result) < 0)
+		return 0;
+
+	suffix = strrchr(unit, '.');
+	if (!suffix || !strcmp(suffix, ".device") ||
+	    !strcmp(suffix, ".slice") || !strcmp(suffix, ".scope"))
+		return 0;
+
+	done = !strcmp(result, "done");
+	if (done)
+		verb = !strcmp(suffix, ".target") ? "Reached target" :
+		       !strcmp(suffix, ".mount") ? "Mounted" :
+		       !strcmp(suffix, ".socket") ? "Listening on" :
+		       !strcmp(suffix, ".swap") ? "Activated swap" : "Started";
+	else if (!strcmp(result, "failed"))
+		verb = "FAILED";
+	else if (!strcmp(result, "timeout"))
+		verb = "Timed out:";
+	else if (!strcmp(result, "dependency"))
+		verb = "Dependency failed for";
+	else
+		return 0;	/* canceled, skipped */
+
+	if (sd_bus_path_encode("/org/freedesktop/systemd1/unit", unit,
+			       &path) >= 0)
+		sd_bus_get_property_string(job_bus,
+			"org.freedesktop.systemd1", path,
+			"org.freedesktop.systemd1.Unit", "Description",
+			NULL, &desc);
+
+	msg_push(verb, desc && *desc ? desc : unit);
+
+	free(desc);
+	free(path);
+	return 0;
+}
+
+/* Connect to systemd for its job signals; no lines without it. */
+static void jobs_watch(sd_event *event)
+{
+	sd_bus_error error = SD_BUS_ERROR_NULL;
+
+	if (sd_bus_new(&job_bus) < 0 ||
+	    sd_bus_set_address(job_bus, "unix:path=/run/systemd/private") < 0 ||
+	    sd_bus_start(job_bus) < 0 ||
+	    sd_bus_attach_event(job_bus, event, SD_EVENT_PRIORITY_NORMAL) < 0 ||
+	    sd_bus_match_signal(job_bus, NULL, NULL,
+				"/org/freedesktop/systemd1",
+				"org.freedesktop.systemd1.Manager",
+				"JobRemoved", on_job_removed, NULL) < 0 ||
+	    sd_bus_call_method(job_bus, "org.freedesktop.systemd1",
+			       "/org/freedesktop/systemd1",
+			       "org.freedesktop.systemd1.Manager",
+			       "Subscribe", &error, NULL, "") < 0) {
+		fprintf(stderr, "No job signals from systemd: %s\n",
+			error.message ? error.message : "no connection");
+		job_bus = sd_bus_flush_close_unref(job_bus);
+	}
+	sd_bus_error_free(&error);
+}
+
 int get_progress(void)
 {
 	sd_bus_error error = SD_BUS_ERROR_NULL;
@@ -157,6 +264,8 @@ int main()
 	if (r < 0)
 		goto finish;
 
+	jobs_watch(event);
+
 	r = sd_event_now(event, CLOCK_MONOTONIC, &time_now);
 	if (r < 0)
 		goto finish;
@@ -172,6 +281,7 @@ int main()
 
 	r = sd_event_loop(event);
 finish:
+	job_bus = sd_bus_flush_close_unref(job_bus);
 	event = sd_event_unref(event);
 	close(pipe_fd);
 
-- 
2.47.3

