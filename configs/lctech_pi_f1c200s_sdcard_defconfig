BR2_arm=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_TARGET_GENERIC_HOSTNAME="lctech-f1c200s"
BR2_TARGET_GENERIC_ISSUE="Welcome to CarPlay Linux (Lctech Pi F1C200s)"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# Root password LOCKED -- but NOT by this line alone. Buildroot only treats a
# value as pre-hashed if it starts with $1$/$5$/$6$ (system/Config.in:380);
# anything else is taken as CLEAR TEXT and crypt-encoded. So "*" here does not
# lock the account, it sets the password to a single asterisk -- verified in a
# built image, which had a live $5$ hash in /etc/shadow. The actual locking is
# done in post-build.sh, which rewrites root's shadow field to "*" and asserts
# it. This value is only the pre-lock input and never survives to the image.
#
# Do NOT set this to "": that yields PASSWORDLESS root, which alongside the
# always-on AP would let anyone in radio range log in with no credential.
#
# It was "carplay1234", published in this public repo, on a board that now
# starts an AP and dropbear on every boot.
#
# CONSEQUENCE: rootfs-overlay/root/.ssh/authorized_keys is the ONLY way in over
# the network. Anyone flashing a card must have their key in it beforehand or
# their sole access is the serial console. Dropbear also runs with -s (see
# rootfs-overlay/etc/default/dropbear) so it refuses password auth outright.
BR2_TARGET_GENERIC_ROOT_PASSWD="*"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CARPLAY_PATH)/board/lctech/pi-f1c200s/post-build.sh"
# Space-separated LIST. genimage.sh builds sdcard.img; post-image-nand.sh then
# builds kernel.itb and the NAND bundle. NOTE both receive the SAME
# BR2_ROOTFS_POST_SCRIPT_ARGS below (Buildroot cannot vary args per script),
# so post-image-nand.sh ignores the stray "-c <genimage cfg>".
BR2_ROOTFS_POST_IMAGE_SCRIPT="support/scripts/genimage.sh $(BR2_EXTERNAL_CARPLAY_PATH)/board/lctech/pi-f1c200s/post-image-nand.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_CARPLAY_PATH)/board/lctech/pi-f1c200s/genimage-sdcard.cfg"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.42"
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/snapshot/linux-6.18.42.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="sunxi"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CARPLAY_PATH)/board/lctech/pi-f1c200s/linux.fragment $(BR2_EXTERNAL_CARPLAY_PATH)/board/lctech/pi-f1c200s/linux-sdcard.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/suniv-f1c200s-lctech-pi"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_CARPLAY_PATH)/patches/linux-lctech"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# squashfs for the NAND rootfs (mtd2 "rom"), built ALONGSIDE ext4 -- one build
# emits both rootfs.ext4 (SD) and rootfs.squashfs (NAND). host-squashfs is
# pulled in automatically. XZ because the target is a 64 MiB partition and the
# rootfs is 64 MiB of content: measured tar.xz = 21.8 MiB, so xz lands ~25 MiB
# with room to spare. Note the SQUASHFS4 infix in the compression symbol.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# mkimage, to build the kernel FIT for mtd1. Buildroot has NO kernel-FIT
# option of its own, so post-image-nand.sh calls mkimage with our hand-written
# board/lctech/pi-f1c200s/kernel.its. FIT_SUPPORT selects host-dtc.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
# Rootfs partition size for the SD image. (The "bundled sample videos" this
# once sized for are gone -- rootfs-overlay/ is 260K. Actual usage is ~64M.)
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# Overlay: init scripts, the runtime switches, and /preinit for the NAND boot.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CARPLAY_PATH)/rootfs-overlay"
# Merged over busybox's default config. Currently only enables swapon -p, which
# S02swap needs to rank zram above the SD swap; see the fragment for why that
# ordering is a safety property on this board.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CARPLAY_PATH)/board/lctech/pi-f1c200s/busybox.fragment"
# ffmpeg for a quick video-playback test (software decode).
# OUTDEVS pulls in the fbdev output device: ffmpeg ... -f fbdev /dev/fb0
# (the ffmpeg CLI is default-y; swscale handles scaling/pixfmt for the panel).
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_OUTDEVS=y
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
# Bumped 2026.04 -> 2026.07 for the SPI NAND work. 2026.07 ships
# drivers/mtd/nand/spi/gigadevice.c, our exact chip vendor, and a build with
# CONFIG_MTD_SPI_NAND was FEL-booted on the board with `mtd list` correctly
# reporting the 128 MiB part. Both patches/uboot/000{1,2} verified to apply
# cleanly to 2026.07 before the bump.
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.07"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="lctech_pi_f1c200s"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CARPLAY_PATH)/board/lctech/pi-f1c200s/uboot-sdcard.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_SUNXI_TOOLS=y
# --- Mainline cedrus HW decode (blob-free) ---
# libdrm: cedrus decode -> sun4i DEFE atomic NV12+tiled plane (zero-copy KMS).
BR2_PACKAGE_LIBDRM=y

# FastCarPlay with the mainline-cedrus integration (CedrusDecoder, USE_CEDRUS=1).
# Enabling CXX forces a one-time full toolchain rebuild; the package pulls in
# SDL2/openssl/libusb/ffmpeg (v4l2-request hwaccel). Needs USB host for the dongle.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_FASTCARPLAY=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_LIBV4L_UTILS=y
BR2_PACKAGE_LIBUDEV_ZERO=y
# Dropbear SSH server for the dev loop: push a binary + ssh-run tests over the
# AP (or the USB-hub DM9601 ethernet), no reflashing. Key auth via overlay
# authorized_keys; password auth refused (-s) and root's password is locked.
BR2_PACKAGE_DROPBEAR=y
# OpenSSH is enabled ONLY for /usr/libexec/sftp-server, which is the exact path
# dropbear already exec's for SFTP -- today `scp` fails with
# "sh: line 0: /usr/libexec/sftp-server: not found" and only `scp -O` (legacy
# protocol) works. Buildroot's openssh installs the binary to that path under
# _SERVER (package/openssh/openssh.mk).
#
# _SERVER also installs sshd and an S50sshd init script, which would run a
# SECOND ssh daemon alongside S50dropbear -- both at S50. post-build.sh deletes
# S50sshd, following the same pattern already used for S30dbus-daemon /
# S40bluetoothd / S80dnsmasq. Dropbear stays the only daemon and simply gains
# SFTP.
#
# _CLIENT is deliberately NOT enabled: it installs ssh/scp/sftp *clients* on
# the board, which is the wrong direction for deployment.
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
# rsync for the deploy loop: the fastcarplay binary is ~3 MB and changes only
# slightly per build, so rsync-over-SSH delta transfer should cut most of the
# measured 6.0 s push at ~516 KB/s over the AP. Target-side only -- rsync must
# exist at both ends. Selects zlib + popt (zlib is already in via other
# packages). Costs disk, not RAM: nothing runs until a push starts.
BR2_PACKAGE_RSYNC=y
# Boot splash: no psplash -- S00psplash was replaced by S00splash, which blits
# a raw theme from /etc/splash/ into /dev/fb0. Runtime-selectable on the board
# via /etc/splash-theme (persists; shows from the next boot).
BR2_PACKAGE_FFMPEG_EXTRACONF="--enable-v4l2-request --enable-libudev"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_CARPLAY_PATH)/patches"

# Pin the GNU mirror instead of ftpmirror.gnu.org's auto-selector, which can
# land on a slow or stale mirror. Covers GNU packages only (gcc, binutils,
# make, ...) -- NOT a replacement for BR2_BACKUP_SITE, which is the fallback
# for every other package. No trailing slash: Buildroot appends the path.
BR2_GNU_MIRROR="https://mirrors.kernel.org/gnu"

# WiFi + Bluetooth via the ESP32 co-processor (ESP-Hosted-NG on spi1, patch
# 0012 + docs/wireless-esp-hosted.md). The esp32_spi module is loaded on
# demand by `wifi on` -- everything default-off, appliance-style.
BR2_PACKAGE_ESP_HOSTED_NG=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
# BlueZ tools for BT bring-up (hciconfig/hcitool scans need no bluetoothd);
# pulls dbus + libglib2 (~2.5 MB) -- needed later for wireless-AA RFCOMM anyway.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
# bluetoothctl: the management CLI for bluetoothd (power/pair/discoverable,
# and the debug view of what the aa-wireless D-Bus calls actually did).
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# btmon: HCI traffic sniffer -- the aa-wireless debugging microscope.
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
# bluez-alsa (bluealsad): HFP Audio Gateway (UUID 0x111f) for wireless Android
# Auto. The phone will NOT start AA unless the head unit exposes a WORKING
# HFP-AG that completes the RFCOMM service-level connection (it opens a 2nd
# RFCOMM channel and runs AT+BRSF / AT+CIND / AT+CMER). bluez alone does not
# answer that AT dialog; on the reference Pi it was PipeWire's bluez5 SPA
# plugin. bluez-alsa's native backend (ba-rfcomm.c, built with --disable-ofono)
# implements the AG side and is the lightest option that provides the AG role
# (adds alsa-lib + sbc, ~2 MB; PipeWire+WirePlumber would be ~15-25 MB RAM).
# No modem or call audio is used -- only the SLC must complete. `bt on`
# launches `bluealsa -p hfp-ag` right after bluetoothd (the daemon is named
# `bluealsa` in v4.3.1; `bluealsad` only in later releases).
BR2_PACKAGE_BLUEZ_ALSA=y
# SoftAP userspace (wireless Android Auto needs the head unit to be the AP,
# and the wireless dev loop rides the same AP): hostapd drives the NG driver's
# cfg80211 AP mode (compiled in with CONFIG_AP_SUPPORT); dnsmasq hands out the
# leases. The AP is now DEFAULT-ON -- rootfs-overlay/etc/ap-enabled ships in
# the image so a freshly flashed card is reachable with no provisioning.
# post-build.sh still drops the S80dnsmasq autostart; S44ap runs the AP's own
# dnsmasq with -C /etc/dnsmasq-ap.conf.
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_DNSMASQ=y
# CONFIG_BR2_PACKAGE_DNSMASQ_TFTP default y -- unused here
# BR2_PACKAGE_DNSMASQ_TFTP is not set

# iperf3: local MUSB-host-DMA stress test over the RTL8153 USB NIC.
# `iperf3 --bidir` drives concurrent bulk RX-DMA + TX across the shared BUS_SEL
# datapath (the kernel's documented tx-fifo-flush repro) with no phone needed.
BR2_PACKAGE_IPERF3=y

# musb-collision-test: deterministic RX-DMA-vs-TX-PIO collision reproducer,
# run on the board (host) against a g_zero gadget peer. Phase 0/1 of
# docs/musb-datapath-serialization-roadmap.md.
BR2_PACKAGE_CP_MUX_PROBE=y
BR2_PACKAGE_MUSB_COLLISION_TEST=y

# mtd-utils for the on-board GigaDevice SPI NAND (128 MiB on spi0, the chip the
# vendor firmware boots from). Kernel side is CONFIG_MTD_SPI_NAND in
# linux.fragment; without these binaries the NAND is visible but untouchable.
#
# nanddump is the immediate reason: it produces a BIT-EXACT backup including the
# OOB area and bad-block markers, which a plain `dd` of /dev/mtdN cannot -- dd
# sees only the data area. That distinction matters because a dd image cannot
# faithfully restore a chip whose factory bad-block markers we would otherwise
# destroy.
#
# The rest are the write path we need afterwards: flash_erase (NAND must be
# erased before programming and erase is per 128 KiB block), nandwrite (skips
# bad blocks, unlike dd), flashcp, and mtdinfo/mtd_debug for inspection.
# Deliberately NOT enabling the UBI/UBIFS or JFFS2 utils yet -- the stock layout
# is squashfs+jffs2 rather than UBI, and which of those we mirror is still open.
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_NANDDUMP=y
BR2_PACKAGE_MTD_NANDWRITE=y
BR2_PACKAGE_MTD_FLASH_ERASE=y
BR2_PACKAGE_MTD_FLASHCP=y
BR2_PACKAGE_MTD_MTDINFO=y
BR2_PACKAGE_MTD_MTD_DEBUG=y
