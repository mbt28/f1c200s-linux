# f1c200s-linux — pinned upstream versions and sources.
# Sourced by scripts/fetch-sources.sh and scripts/build.sh. Edit to re-pin.

# --- Buildroot (fetched here; it in turn downloads the kernel + U-Boot) ---
BUILDROOT_VERSION="2026.05"
BUILDROOT_GIT="https://gitlab.com/buildroot.org/buildroot.git"

# --- Versions Buildroot pulls from upstream (must match the defconfig) ---
# BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE
# NOTE: bumping this is NOT enough -- the defconfig carries the version in two
# more places, and BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION is the one that
# actually supplies the source, so a stale URL silently builds the old kernel:
#   BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE
#   BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION   <- the URL embeds the version
#   BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_<ver>
# The source is a git.kernel.org snapshot, not a kernel.org release tarball:
# kernel.org keeps only the newest point release of a series (older ones 404),
# whereas snapshots keep every version.
LINUX_VERSION="6.18.42"
# BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE
UBOOT_VERSION="2026.04"


# --- ESP32 wireless co-processor (informational; the build pin lives in ---
# package/esp-hosted-ng/esp-hosted-ng.mk). Driver and ESP32 firmware MUST
# come from the same release: the transport does a strict version handshake.
# Flashing: docs/wireless-esp-hosted.md appendix.
ESP_HOSTED_RELEASE="master-2026-07-11"  # firmware NG-1.0.6.0.4 = commit 53bdeeec (v3 custom build)

# --- Buildroot external tree identity (defconfig references BR2_EXTERNAL_CARPLAY_PATH) ---
BR2_EXTERNAL_NAME="CARPLAY"
DEFCONFIG="lctech_pi_f1c200s_sdcard_defconfig"

# --- Working directories (git-ignored; created by the scripts) ---
# Buildroot checkout and the out-of-tree build output live here.
BUILDROOT_DIR="buildroot"
OUTPUT_DIR="output"
