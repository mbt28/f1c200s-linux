config BR2_PACKAGE_OSTREE
	bool "ostree"
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR # libglib2
	depends on BR2_TOOLCHAIN_HAS_THREADS # libglib2
	depends on BR2_TOOLCHAIN_USES_GLIBC # a static ostree-prepare-root
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_E2FSPROGS
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_LIBMOUNT
	select BR2_PACKAGE_XZ
	select BR2_PACKAGE_ZLIB
	help
	  OSTree, for the board's whole-system updates (docs/ostree.md).
	  Commits are signed with ed25519 through OpenSSL, with no GnuPG;
	  ostree-prepare-root is static, so that the kernel can run it as
	  init, with no initramfs. Buildroot's own libostree (2023.8) has
	  neither: this is the version LEHU OS runs.

	  https://ostreedev.github.io/ostree/

comment "ostree needs a glibc toolchain w/ threads, dynamic library, wchar"
	depends on BR2_USE_MMU
	depends on !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_USES_GLIBC || BR2_STATIC_LIBS
