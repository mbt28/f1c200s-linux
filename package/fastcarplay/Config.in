config BR2_PACKAGE_FASTCARPLAY
	bool "FastCarPlay"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_WCHAR # bluez5_utils -> libglib2
	depends on BR2_USE_MMU # bluez5_utils -> dbus
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS # slint-cpp
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_12 # slint-cpp (C++20 UI facade)
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_FFMPEG_SWSCALE
	select BR2_PACKAGE_LIBUSB
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_ALSA_LIB
	# fixed-point Opus: CarPlay Opus decode and the wireless mic encoder
	select BR2_PACKAGE_OPUS
	# USE_SLINT: the on-device UI
	select BR2_PACKAGE_SLINT_CPP
	# USE_AA_WIRELESS: BT bootstrap talks to BlueZ over D-Bus and links
	# -lbluetooth (Buildroot requires _DEPENDENCIES to be selected here)
	select BR2_PACKAGE_BLUEZ5_UTILS
	select BR2_PACKAGE_DBUS
	# USE_CP_WIRED: wired CarPlay opens com.apple.carkit.service over our own
	# usbmux (cp_usbmux) via libimobiledevice; cp_usbmux serves plists with libplist.
	select BR2_PACKAGE_LIBIMOBILEDEVICE
	select BR2_PACKAGE_LIBPLIST
	help
	  C++ native CarPlay (wireless/wired) and Android Auto
	  (wireless/USB) receiver.

	  Needs two kernel options. Buildroot's Kconfig cannot express a Linux
	  config symbol, so they are not "depends on" here -- the package
	  enables them through LINUX_CONFIG_FIXUPS and the board post-build
	  script fails the build if they are missing:
	    CONFIG_IPV6        both CarPlay backends hand the phone an IPv6
	                       link-local address to connect back to, so the
	                       :7000 server cannot start without it. Note the
	                       sunxi defconfig disables IPv6 explicitly.
	    CONFIG_I2C_CHARDEV the MFi authentication coprocessor is reached
	                       from userspace as /dev/i2c-N.

	  https://github.com/mbt28/FastCarPlay

comment "FastCarPlay needs a toolchain w/ C++, threads, gcc >= 12, dynamic library"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_12 || BR2_STATIC_LIBS
