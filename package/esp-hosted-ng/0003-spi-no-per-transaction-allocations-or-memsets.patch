 		return;
 	}
@@ -405,8 +468,11 @@
 		dev_kfree_skb(rx_skb);
 		dev_kfree_skb(tx_skb);
 	} else {
+		if (!rx_skb)
+			rx_skb = esp_spi_rx_from_scratch();
