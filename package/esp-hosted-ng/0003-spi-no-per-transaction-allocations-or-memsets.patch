+		if (len >= SPI_BUF_SIZE) {
+			trans.tx_buf = tx_skb->data;
+		} else if (len > SPI_BUF_SIZE / 2 && !skb_is_nonlinear(tx_skb) &&
+			   skb_tailroom(tx_skb) >= SPI_BUF_SIZE - len) {
+			/* the tailroom is there: zeroes the short pad, no realloc */
 			if (skb_put_padto(tx_skb, SPI_BUF_SIZE)) {
 				esp_err("Failed to pad TX buffer to SPI size\n");
 				tx_skb = NULL;
 				return;
 			}
+			trans.tx_buf = tx_skb->data;
+		} else {
+			if (skb_copy_bits(tx_skb, 0, spi_tx_bounce, len)) {
+				esp_err("Failed to copy TX frame\n");
+				dev_kfree_skb(tx_skb);
+				return;
+			}
+			/* zero only what the previous short frame left behind */
+			if (spi_tx_bounce_used > len)
+				memset(spi_tx_bounce + len, 0, spi_tx_bounce_used - len);
+			spi_tx_bounce_used = len;
+			trans.tx_buf = spi_tx_bounce;
 		}
-
-		trans.tx_buf = tx_skb->data;
 		esp_hex_dump_verbose("tx: ", trans.tx_buf, 32);
 	} else {
-		tx_skb = esp_spi_alloc_skb(SPI_BUF_SIZE);
-		if (!tx_skb) {
-			esp_err("Failed to alloc dummy SPI TX skb\n");
