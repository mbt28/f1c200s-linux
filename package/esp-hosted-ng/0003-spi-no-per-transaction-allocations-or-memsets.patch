spi: no per-transaction allocations or memsets

Every transaction moves one fixed SPI_BUF_SIZE (1600-byte) frame in
both directions, and the worker paid for that per transaction on top of
the transfer itself, which shows on a slow host (F1C200s, ARM926 at
408 MHz, ~1 ms of CPU per packet over this link):

- the RX buffer was zeroed although the transfer overwrites all of it;
- with nothing to send, a dummy TX skb was allocated and zeroed;
- a short TX frame (every TCP ACK) was padded with skb_put_padto(),
  which reallocates the skb to 1600 bytes and copies it when the
  tailroom is short -- for a stack skb it always is;
- with the ESP signalling nothing to send (data-ready low), an RX skb
  was still allocated, only to be freed again.

Now the zero frame and a bounce buffer for short TX frames are
preallocated, together with a scratch RX buffer used when data-ready is
low; an RX skb is allocated only for a frame that arrived (also when
one arrives after data-ready was sampled). Large frames with enough
tailroom are still padded in place. The bytes on the wire are
unchanged: data, then zero padding (the bounce buffer re-zeroes only
what the previous short frame left).

Also fixes the last-instant readiness check requeueing the dummy TX
frame onto the real TX queue (and counting it in tx_pending) when there
was nothing to send: only a real frame is requeued now.

Signed-off-by: mbt28 <btekbas@gmail.com>

--- a/esp_hosted_ng/host/spi/esp_spi.c
+++ b/esp_hosted_ng/host/spi/esp_spi.c
@@ -8,6 +8,7 @@
 #include <linux/gpio.h>
 #include <linux/delay.h>
 #include <linux/module.h>
+#include <linux/slab.h>
 #include "esp_spi.h"
 #include "esp_if.h"
 #include "esp_api.h"
@@ -35,6 +36,17 @@
 static char hardware_type = ESP_FIRMWARE_CHIP_UNRECOGNIZED;
 static atomic_t tx_pending;
 
+/*
+ * Every transaction moves a full SPI_BUF_SIZE frame both ways. These
+ * preallocated buffers (kmalloc: cache-line aligned, DMA-safe) spare the
+ * per-transaction allocations and memsets: the zero frame sent when there is
+ * nothing to transmit, a bounce buffer for short TX frames, and the RX
+ * buffer for transactions where the ESP signalled nothing to send. Only
+ * esp_spi_work() touches them.
+ */
+static u8 *spi_tx_zero, *spi_tx_bounce, *spi_rx_scratch;
+static u32 spi_tx_bounce_used;	/* bytes of the last frame in spi_tx_bounce */
+
 static struct sk_buff *esp_spi_alloc_skb(u32 len)
 {
 	struct sk_buff *skb = NULL;
@@ -284,6 +296,36 @@
 	return 0;
 }
 
+/*
+ * The ESP signalled nothing to send, so the transaction normally returns its
+ * empty frame into spi_rx_scratch. If a frame arrived anyway (queued after
+ * data-ready was sampled), hand it on in an skb; anything that is not the
+ * empty frame goes to process_rx_buf(), which validates (and logs) it.
+ */
+static struct sk_buff *esp_spi_rx_from_scratch(void)
+{
+	struct esp_payload_header *header = (struct esp_payload_header *)spi_rx_scratch;
+	u16 len = le16_to_cpu(header->len);
+	u16 offset = le16_to_cpu(header->offset);
+	struct sk_buff *skb;
+	u32 copy = SPI_BUF_SIZE;
+
+	/* the empty frame: process_rx_buf() drops these silently too */
+	if (!len || header->if_type >= ESP_MAX_IF)
+		return NULL;
+
+	if (ESP_OFFSET_VALID(offset) && len + offset <= SPI_BUF_SIZE)
+		copy = len + offset;
+
+	skb = esp_spi_alloc_skb(SPI_BUF_SIZE);
+	if (!skb) {
+		esp_err("Failed to alloc SPI RX skb\n");
+		return NULL;
+	}
+	skb_put_data(skb, spi_rx_scratch, copy);
+	return skb;
+}
+
 static void esp_spi_work(struct work_struct *work)
 {
 	struct spi_transfer trans;
@@ -331,45 +373,62 @@
 	memset(&trans, 0, sizeof(trans));
 	trans.speed_hz = spi_context.spi_clk_mhz * NUMBER_1M;
 
-	/* Setup and execute SPI transaction
-	 *	Tx_buf: Check if tx_q has valid buffer for transmission,
-	 *		else keep it blank
+	/* Setup and execute SPI transaction. The transfer fills all of
+	 * SPI_BUF_SIZE in both directions, so neither buffer is zeroed for it;
+	 * the TX frame is still zero-padded, so the bytes on the wire are
+	 * unchanged.
+	 *	Tx_buf: the queued frame -- in place when it is large and has the
+	 *		tailroom, else copied into the bounce buffer (a TCP ACK
+	 *		would otherwise be reallocated to 1600 bytes) -- or the
+	 *		preallocated zero frame when there is nothing to send.
 	 *
-	 *	Rx_buf: Allocate memory for incoming data. This will be freed
-	 *		immediately if received buffer is invalid.
-	 *		If it is a valid buffer, upper layer will free it.
+	 *	Rx_buf: a fresh skb when the ESP signals data (the upper layer
+	 *		frees it, or it is freed here if invalid), else the
+	 *		scratch buffer, copied out only if a frame arrived anyway.
 	 * */
 
 	if (tx_skb) {
-		if (tx_skb->len < SPI_BUF_SIZE) {
+		u32 len = tx_skb->len;
