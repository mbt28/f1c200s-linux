-		memset((void *)trans.tx_buf, 0, SPI_BUF_SIZE);
+		trans.tx_buf = spi_tx_zero;
 	}
 
-	rx_skb = esp_spi_alloc_skb(SPI_BUF_SIZE);
-	if (!rx_skb) {
-		esp_err("Failed to alloc SPI RX skb\n");
-		dev_kfree_skb(tx_skb);
-		return;
+	if (rx_pending) {
+		rx_skb = esp_spi_alloc_skb(SPI_BUF_SIZE);
+		if (!rx_skb) {
+			esp_err("Failed to alloc SPI RX skb\n");
+			dev_kfree_skb(tx_skb);
+			return;
+		}
+		rx_buf = skb_put(rx_skb, SPI_BUF_SIZE);
