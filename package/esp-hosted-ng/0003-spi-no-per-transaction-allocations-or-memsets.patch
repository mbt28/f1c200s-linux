-		if (process_rx_buf(rx_skb))
+		if (rx_skb && process_rx_buf(rx_skb))
 			dev_kfree_skb(rx_skb);
 
 		dev_kfree_skb(tx_skb);
@@ -593,6 +659,16 @@
 		return -EFAULT;
 	}
 
+	spi_tx_zero = kzalloc(SPI_BUF_SIZE, GFP_KERNEL);
+	spi_tx_bounce = kzalloc(SPI_BUF_SIZE, GFP_KERNEL);
+	spi_rx_scratch = kmalloc(SPI_BUF_SIZE, GFP_KERNEL);
+	spi_tx_bounce_used = 0;
+	if (!spi_tx_zero || !spi_tx_bounce || !spi_rx_scratch) {
+		esp_err("Failed to allocate the SPI transfer buffers\n");
+		spi_exit();
+		return -ENOMEM;
+	}
+
 	INIT_WORK(&spi_context.spi_work, esp_spi_work);
 
 	for (prio_q_idx = 0; prio_q_idx < MAX_PRIORITY_QUEUES; prio_q_idx++) {
@@ -672,6 +748,12 @@
 		spi_context.spi_workqueue = NULL;
 	}
 
+	/* the worker is gone: nothing uses the transfer buffers any more */
+	kfree(spi_tx_zero);
+	kfree(spi_tx_bounce);
+	kfree(spi_rx_scratch);
+	spi_tx_zero = spi_tx_bounce = spi_rx_scratch = NULL;
