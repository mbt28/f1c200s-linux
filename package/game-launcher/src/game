#!/bin/sh
# game NAME [args...] -- play one of the bundled games on the LCD (SD card
# image only: the NAND image ships without them). FastCarPlay owns the display
# and grabs the keyboards, so it is stopped for the game and started again
# afterwards -- only if it was running before. The CPU runs the game at
# 792 MHz (the clock validated on this board, docs/cpu-overclock.md) and goes
# back to its previous speed when the game quits.
#   game                        list the games
#   game doom [freedoom1]       Doom engine (prboom) on Freedoom Phase 2, or 1
#   game tyrian                 OpenTyrian
#   game lbreakout2             LBreakout2
#   game ltris                  LTris
# Any keyboard works, Bluetooth ones included (through the VT). There is no
# mouse. Quit from the game's own menu (SDL 1.2 games ignore SIGTERM in their
# menus). The game's output goes to /tmp/game.log.
C=/sys/devices/system/cpu/cpu0/cpufreq
usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

# A game that died without cleaning up leaves VT switching locked and the
# framebuffer in its own mode (LBreakout2/LTris run at 640x480): the next game
# would hang waiting for its VT, or find no 800x480 mode. Reset both, before
# and after every game.
reset_display() {
	/usr/sbin/vtreset 2>/dev/null
	fbset -xres "${FB%,*}" -yres "${FB#*,}" 2>/dev/null
}
FB=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null)

case "$1" in
doom)
	shift; W=freedoom2
	case "$1" in freedoom1|freedoom2) W=$1; shift ;; esac
	set -- /usr/games/prboom -iwad /usr/share/games/doom/$W.wad \
		-width 800 -height 480 "$@" ;;
tyrian)		shift; set -- /usr/bin/opentyrian -t /usr/share/opentyrian/data "$@" ;;
lbreakout2)	shift; set -- /usr/bin/lbreakout2 "$@" ;;
ltris)		shift; set -- /usr/bin/ltris "$@" ;;
*)		usage ;;
esac
[ -x "$1" ] || { echo "game: $1 is not installed (the games are on the SD card image only)"; exit 1; }

# LEHU owns the display and the keyboards: stopped for the game (SIGTERM, it
# says goodbye to the phone and saves), started again after it as f1c, as
# ~/.profile starts it, in the background (its log: ~/.lehu/run.log).
app=; pidof lehu >/dev/null 2>&1 && app=1
if [ -n "$app" ]; then
	killall lehu 2>/dev/null
	n=0
	while pidof lehu >/dev/null 2>&1 && [ "$n" -lt 70 ]; do
		usleep 100000 2>/dev/null || sleep 1
		n=$((n + 1))
	done
	killall -9 lehu 2>/dev/null
fi
was=$(cat $C/scaling_cur_freq 2>/dev/null)
[ -w $C/scaling_setspeed ] && echo 792000 > $C/scaling_setspeed

reset_display
# SDL 1.2: framebuffer backend, keyboard through the VT, no mouse device
cd $HOME
HOME=$HOME SDL_VIDEODRIVER=fbcon SDL_FBDEV=/dev/fb0 SDL_NOMOUSE=1 \
	"$@" > /tmp/game.log 2>&1
rc=$?
reset_display

[ -n "$was" ] && [ -w $C/scaling_setspeed ] && echo "$was" > $C/scaling_setspeed
[ -n "$app" ] && su f1c -c 'setsid lehu </dev/null >/dev/null 2>&1 &' 
exit $rc
